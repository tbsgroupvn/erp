# ============================================
# Docker Ignore File
# Exclude unnecessary files from Docker builds
# ============================================

# Dependencies
**/node_modules
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

# Testing
**/coverage
**/.nyc_output
**/test-results
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/__tests__
**/__mocks__

# Build outputs
**/dist
**/build
**/.next
**/out

# IDE
**/.vscode
**/.idea
**/.DS_Store
**/*.swp
**/*.swo
**/*.swn
**/.history

# Environment & Secrets
**/.env
**/.env.local
**/.env*.local
**/.env.development
**/.env.test
**/.env.production
**/*.pem
**/*.key
**/*.crt

# Git
**/.git
**/.gitignore
**/.gitattributes

# Docker
**/Dockerfile*
**/docker-compose*
**/.dockerignore

# Documentation
**/README.md
**/CHANGELOG.md
**/LICENSE
**/docs
**/*.md

# CI/CD
**/.github
**/.gitlab-ci.yml
**/.circleci
**/azure-pipelines.yml

# Logs
**/logs
**/*.log

# Temporary files
**/tmp
**/temp
**/.cache

# Database
**/*.db
**/*.sqlite
**/*.sqlite3

# OS
**/Thumbs.db
**/*.DS_Store

# Prisma
**/prisma/migrations

# TypeScript
**/*.tsbuildinfo
