# ============================================
# TBS ERP - Docker Environment Variables
# Copy this file to .env for local development
# ============================================

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=production

# ============================================
# PORTS
# ============================================
POSTGRES_PORT=5433
REDIS_PORT=6379
BACKEND_PORT=3001
FRONTEND_PORT=3000

# ============================================
# DATABASE
# ============================================
POSTGRES_USER=tbs_user
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=tbs_erp

# ============================================
# JWT
# ============================================
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# JWT Refresh Token Secret (required)
JWT_REFRESH_SECRET=change-me-in-production-use-openssl-rand-hex-64

# ============================================
# URLS
# ============================================
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================
# MONITORING (Optional)
# ============================================
SENTRY_DSN=

# ============================================
# MinIO / S3 Storage
# ============================================
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_DRIVE=tbs-drive
MINIO_BUCKET_CHAT=tbs-chat
MINIO_BUCKET_MEDIA=tbs-media
MINIO_PUBLIC_URL=http://localhost:9000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================
# SECURITY - 2FA Encryption (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================
TWO_FA_ENCRYPTION_KEY=change-me-use-openssl-rand-hex-32
TWO_FA_ENCRYPTION_SALT=change-me-use-openssl-rand-hex-16

# Redis password (required for production)
REDIS_PASSWORD=change-me-in-production

# Field-level encryption for PII data (required)
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=change-me-use-openssl-rand-hex-32

# ============================================
# Jitsi Meet (Video Call)
# Leave JITSI_APP_ID and JITSI_SECRET empty to use public meet.jit.si
# Fill them in for self-hosted Jitsi with JWT auth
# ============================================
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=
JITSI_SECRET=

# ============================================
# Anthropic AI (TBS Assistant)
# Get your key at: https://console.anthropic.com/
# ============================================
ANTHROPIC_API_KEY=sk-ant-

# ============================================
# SMTP Email
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@tbslogistics.com
SMTP_FROM_NAME=TBS Logistics
