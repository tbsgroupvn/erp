// ============================================
// SYSTEM — Approval, Notification, Task
// ============================================

enum NotificationType {
  ORDER
  APPROVAL
  FINANCE
  WAREHOUSE
  SYSTEM
  PAYMENT
  ALERT
}

enum DocumentEntityType {
  ORDER
  CUSTOMER
  CONTAINER
  PACKAGE
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  DEAD_LETTER
}

enum ApprovalCategory {
  SALES
  FINANCE
  HR
  LOGISTICS
  CUSTOM
}

// ============================================
// APPROVAL FLOW TEMPLATE — Pre-built templates for rapid setup
// ============================================

model ApprovalFlowTemplate {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          String
  nameVi        String           @map("name_vi")
  description   String?
  descriptionVi String?          @map("description_vi")
  category      ApprovalCategory
  triggerType   String           @map("trigger_type")
  nodesJson     Json             @map("nodes_json")
  edgesJson     Json             @map("edges_json")
  isDefault     Boolean          @default(false) @map("is_default")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([category])
  @@index([triggerType])
  @@map("approval_flow_templates")
}

// ============================================
// APPROVAL FLOW DEFINITION — Template quy trình
// ============================================

model ApprovalFlowDefinition {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    ApprovalCategory?
  triggerType String   @map("trigger_type")  // ApprovalType value
  isActive    Boolean  @default(true)   @map("is_active")
  version     Int      @default(1)
  formSchema  Json?    @map("form_schema")
  createdBy   String   @map("created_by")

  nodes       ApprovalFlowNode[]
  edges       ApprovalFlowEdge[]
  instances   Approval[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@unique([triggerType, version])
  @@map("approval_flow_definitions")
}

model ApprovalFlowNode {
  id               String           @id @default(cuid())
  flowDefinitionId String           @map("flow_definition_id")
  nodeKey          String           @map("node_key")
  nodeType         ApprovalNodeType @map("node_type")
  label            String?

  // APPROVER fields
  approverType     ApproverType?    @map("approver_type")
  approverRole     UserRole?        @map("approver_role")
  approverUserId   String?          @map("approver_user_id")
  approvalMode     ApprovalMode?    @map("approval_mode")

  // CONDITION fields
  conditionField    String?         @map("condition_field")
  conditionOperator String?         @map("condition_operator")  // GT, GTE, LT, LTE, EQ, NEQ, IN
  conditionValue    String?         @map("condition_value")

  // SLA
  deadlineHours         Int?    @map("deadline_hours")
  autoAction            String? @map("auto_action")  // AUTO_APPROVE, AUTO_ESCALATE
  autoActionDelayHours  Int?    @map("auto_action_delay_hours")

  // Condition grouping
  conditionGroupId    String? @map("condition_group_id")
  conditionGroupLogic String? @map("condition_group_logic")  // AND, OR

  // Field permissions: { "amount": "read", "note": "edit", "internal": "hidden" }
  fieldPermissions Json?            @map("field_permissions")

  // Visual builder position
  positionX        Float?           @map("position_x")
  positionY        Float?           @map("position_y")

  flowDefinition   ApprovalFlowDefinition @relation(fields: [flowDefinitionId], references: [id], onDelete: Cascade)
  outgoingEdges    ApprovalFlowEdge[] @relation("EdgeSource")
  incomingEdges    ApprovalFlowEdge[] @relation("EdgeTarget")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([flowDefinitionId, nodeKey])
  @@map("approval_flow_nodes")
}

model ApprovalFlowEdge {
  id                  String   @id @default(cuid())
  flowDefinitionId    String   @map("flow_definition_id")
  sourceNodeId        String   @map("source_node_id")
  targetNodeId        String   @map("target_node_id")
  label               String?
  conditionExpression String?  @map("condition_expression")  // "amount > 50000000"
  sortOrder           Int      @default(0) @map("sort_order")
  isDefault           Boolean  @default(false) @map("is_default")

  flowDefinition      ApprovalFlowDefinition @relation(fields: [flowDefinitionId], references: [id], onDelete: Cascade)
  sourceNode          ApprovalFlowNode @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode          ApprovalFlowNode @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  createdAt           DateTime @default(now()) @map("created_at")

  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@map("approval_flow_edges")
}

// ============================================
// APPROVAL — Instance phê duyệt
// ============================================

model Approval {
  id               String         @id @default(cuid())
  type             ApprovalType
  referenceId      String         @map("reference_id")  // orderId, voucherId, etc.
  referenceCode    String?        @map("reference_code")
  requestedBy      String         @map("requested_by")
  requestData      Json?          @map("request_data")  // Dữ liệu cần duyệt

  status           ApprovalStatus @default(PENDING)
  currentStep      Int            @default(1) @map("current_step")
  totalSteps       Int            @default(1) @map("total_steps")

  // New fields for graph-based engine
  flowDefinitionId String?        @map("flow_definition_id")
  currentNodeKey   String?        @map("current_node_key")
  isUrgent         Boolean        @default(false) @map("is_urgent")
  deadline         DateTime?
  batchId          String?        @map("batch_id")

  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  flowDefinition   ApprovalFlowDefinition? @relation(fields: [flowDefinitionId], references: [id], onDelete: SetNull)
  steps            ApprovalStep[]
  ccUsers          ApprovalCC[]
  comments         ApprovalComment[]
  actionLogs       ApprovalActionLog[]
  analytics        ApprovalAnalytics?

  @@index([type, status])
  @@index([requestedBy])
  @@index([requestedBy, status])
  @@index([status, createdAt])
  @@index([referenceId])
  @@index([flowDefinitionId])
  @@index([referenceId, type], map: "idx_approvals_reference_type")
  @@index([status, type, createdAt], map: "idx_approvals_status_type_created")
  @@map("approvals")
}

model ApprovalStep {
  id                  String          @id @default(cuid())
  approvalId          String          @map("approval_id")
  stepNumber          Int             @map("step_number")
  approverRole        UserRole        @map("approver_role")
  approverId          String?         @map("approver_id")
  status              ApprovalStatus  @default(PENDING)
  comment             String?
  decidedAt           DateTime?       @map("decided_at")

  // New fields for graph-based engine
  nodeId              String?         @map("node_id")
  assignedUserId      String?         @map("assigned_user_id")
  approvalMode        ApprovalMode?   @map("approval_mode")
  groupKey            String?         @map("group_key")
  delegatedFromUserId String?         @map("delegated_from_user_id")
  deadlineAt          DateTime?       @map("deadline_at")
  isOverdue           Boolean         @default(false) @map("is_overdue")

  approval            Approval        @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  @@unique([approvalId, stepNumber])
  @@index([assignedUserId, status])
  @@index([groupKey])
  @@map("approval_steps")
}

// ============================================
// APPROVAL CC — Người theo dõi
// ============================================

model ApprovalCC {
  id          String   @id @default(cuid())
  approvalId  String   @map("approval_id")
  userId      String   @map("user_id")
  nodeId      String?  @map("node_id")
  notifiedAt  DateTime @default(now()) @map("notified_at")

  approval    Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@unique([approvalId, userId])
  @@map("approval_cc")
}

// ============================================
// APPROVAL COMMENT — Bình luận
// ============================================

model ApprovalComment {
  id          String   @id @default(cuid())
  approvalId  String   @map("approval_id")
  userId      String   @map("user_id")
  content     String
  stepId      String?  @map("step_id")

  createdAt   DateTime @default(now()) @map("created_at")

  approval    Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([approvalId])
  @@map("approval_comments")
}

// ============================================
// APPROVAL ACTION LOG — Nhật ký hành động
// ============================================

model ApprovalActionLog {
  id               String         @id @default(cuid())
  approvalId       String         @map("approval_id")
  userId           String         @map("user_id")
  action           ApprovalAction
  dataSnapshot     Json?          @map("data_snapshot")
  comment          String?
  delegateToUserId String?        @map("delegate_to_user_id")
  addedStepId      String?        @map("added_step_id")

  createdAt        DateTime       @default(now()) @map("created_at")

  approval         Approval       @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([approvalId])
  @@map("approval_action_logs")
}

// ============================================
// APPROVAL ANALYTICS — Phân tích hiệu suất phê duyệt
// ============================================

model ApprovalAnalytics {
  id               String         @id @default(cuid())
  approvalId       String         @unique @map("approval_id")
  approval         Approval       @relation(fields: [approvalId], references: [id])
  type             ApprovalType
  flowDefinitionId String?        @map("flow_definition_id")
  totalDurationMs  BigInt?        @map("total_duration_ms")
  stepDurations    Json?          @map("step_durations")
  bottleneckStep   Int?           @map("bottleneck_step")
  bottleneckRole   String?        @map("bottleneck_role")
  wasEscalated     Boolean        @default(false) @map("was_escalated")
  wasOverdue       Boolean        @default(false) @map("was_overdue")
  finalStatus      ApprovalStatus @map("final_status")
  completedAt      DateTime?      @map("completed_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([type, completedAt])
  @@index([flowDefinitionId])
  @@map("approval_analytics")
}

// ============================================
// APPROVAL DELEGATION — Ủy quyền khi vắng mặt
// ============================================

model ApprovalDelegation {
  id            String   @id @default(cuid())
  fromUserId    String   @map("from_user_id")
  toUserId      String   @map("to_user_id")
  approvalTypes String[] @map("approval_types")  // empty = all types
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  reason        String?
  isActive      Boolean  @default(true) @map("is_active")

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([fromUserId, isActive])
  @@index([toUserId, isActive])
  @@map("approval_delegations")
}

model Notification {
  id          String              @id @default(cuid())
  userId      String              @map("user_id")
  title       String
  body        String
  channel     NotificationChannel @default(APP_PUSH)
  type        NotificationType?
  referenceId String?             @map("reference_id")
  isRead      Boolean             @default(false) @map("is_read")
  isUrgent    Boolean             @default(false) @map("is_urgent")
  priority    NotificationPriority @default(NORMAL)
  data        Json?
  sentAt      DateTime?           @map("sent_at")
  readAt      DateTime?           @map("read_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@index([createdAt])
  @@index([userId, isRead, createdAt], map: "idx_notifications_user_read_created")
  @@index([userId, type, isRead], map: "idx_notifications_user_type_read")
  @@map("notifications")
}

model Document {
  id           String           @id @default(cuid())
  name         String
  category     DocumentCategory
  entityType   DocumentEntityType
  entityId     String
  fileName     String
  fileSize     Int
  mimeType     String
  storageKey   String
  version      Int              @default(1)
  versionHistory Json?
  tags         String[]
  uploadedBy   String
  isDeleted    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  uploadedByUser User           @relation(fields: [uploadedBy], references: [id])

  @@index([entityType, entityId])
  @@index([category])
  @@index([uploadedBy])
  @@map("documents")
}

model Task {
  id             String       @id @default(cuid())
  code           String       @unique
  title          String
  description    String?
  assigneeId     String
  assignee       User         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(OPEN)
  dueDate        DateTime?
  entityType     String?      // ORDER, CUSTOMER, APPROVAL
  entityId       String?
  tags           String[]
  comments       TaskComment[]
  createdBy      String
  createdByUser  User         @relation("TaskCreator", fields: [createdBy], references: [id])
  completedAt    DateTime?

  // Order-as-Project fields
  sourceType     String?      @map("source_type")      // MANUAL, AUTO_STAGE, AUTO_SLA_ESCALATION
  orderStage     String?      @map("order_stage")      // OrderStatus that triggered this task
  departmentCode String?      @map("department_code")   // Department related to this task
  isAutoCreated  Boolean      @default(false) @map("is_auto_created")

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@index([createdBy])
  @@index([entityType, entityId, orderStage])
  @@index([departmentCode, status])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_comments")
}

model Vendor {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  country       String   @default("CN")
  paymentTerms  String?
  /// @encrypted
  bankName      String?
  /// @encrypted
  bankAccount   String?
  isApproved    Boolean  @default(false)
  ratings       VendorRating[]
  supplierOrders   SupplierOrder[]   @relation("SupplierOrderVendor")
  purchaseRequests PurchaseRequest[] @relation("PurchaseRequestVendor")
  purchaseOrders   PurchaseOrder[]   @relation("PurchaseOrderVendor")
  accountPayables  AccountPayable[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("vendors")
}

model VendorRating {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  score     Int      // 1-5
  category  String?  // QUALITY, DELIVERY, PRICE, COMMUNICATION
  comment   String?
  orderId   String?
  createdBy String
  createdAt DateTime @default(now())

  @@index([vendorId])
  @@index([orderId])
  @@index([createdBy])
  @@map("vendor_ratings")
}

// ============================================
// LEGAL DOCUMENT — Quản lý phiên bản tài liệu pháp lý
// ============================================

model LegalDocument {
  id          String   @id @default(cuid())
  type        String   // privacy_policy, terms_of_service, data_processing_agreement
  version     String   // e.g. "1.0", "2.0"
  title       String
  content     String   @db.Text
  locale      String   @default("vi") // vi, zh, en
  effectiveAt DateTime @map("effective_at")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([type, version, locale])
  @@index([type, locale])
  @@index([isActive])
  @@map("legal_documents")
}

// ============================================
// WEBHOOK ENDPOINT — Integration webhook subscriptions
// ============================================

model WebhookEndpoint {
  id          String   @id @default(cuid())
  url         String
  events      String[] // Event types to subscribe to (e.g., "order.created", "payment.completed")
  secret      String   // HMAC-SHA256 signing secret (stored hashed)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  deliveries  WebhookDelivery[]

  @@index([isActive])
  @@map("webhook_endpoints")
}

// ============================================
// WEBHOOK DELIVERY — Delivery attempt tracking
// ============================================

model WebhookDelivery {
  id          String    @id @default(cuid())
  endpointId  String    @map("endpoint_id")
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event       String    // Event type that triggered this delivery
  payload     Json      // Full event payload sent to the endpoint
  statusCode  Int?      @map("status_code")   // HTTP response status code
  response    String?   @db.Text              // Response body (truncated to 4KB)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  status      String    @default("pending")   // pending, success, failed, dead_letter
  errorMessage String?  @map("error_message")
  nextRetryAt DateTime? @map("next_retry_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([endpointId, status])
  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

// ============================================
// API KEY — Partner integration authentication
// ============================================

model ApiKey {
  id          String    @id @default(cuid())
  /// @encrypted
  key         String    @unique   // SHA-256 hash of the actual key
  prefix      String               // First 8 chars of key for identification (e.g., "tbs_pk_ab")
  name        String               // Partner or integration name
  permissions String[]             // Allowed endpoint patterns (e.g., ["orders:read", "webhooks:*"])
  rateLimit   Int       @default(1000) @map("rate_limit") // Requests per hour
  isActive    Boolean   @default(true) @map("is_active")
  expiresAt   DateTime? @map("expires_at")
  lastUsedAt  DateTime? @map("last_used_at")
  lastUsedIp  String?   @map("last_used_ip")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([prefix])
  @@index([isActive])
  @@map("api_keys")
}

// ============================================
// NOTIFICATION RULE — Dynamic notification configuration (Phase 0B)
// ============================================

model NotificationRule {
  id              String   @id @default(cuid())
  name            String
  eventType       String   @map("event_type") // ORDER_STATUS_CHANGE, APPROVAL_NEEDED, etc.
  conditions      Json     // { "newStatus": ["ARRIVED_VN","DELIVERED"], "roles": ["SALE"] }
  channels        String[] // ["APP_PUSH","EMAIL","WEBHOOK"]
  recipientType   String   @map("recipient_type") // ASSIGNED_SALE, CUSTOMER, ROLE, SPECIFIC_USER
  recipientRole   String?  @map("recipient_role") // UserRole when recipientType=ROLE
  recipientUserId String?  @map("recipient_user_id") // when recipientType=SPECIFIC_USER
  templateTitle   String   @map("template_title")
  templateBody    String   @map("template_body") // Supports {{order.code}}, {{customer.name}}
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([eventType, isActive])
  @@map("notification_rules")
}

// ============================================
// ESCALATION RULE — Alert escalation matrix (BGD-4)
// ============================================

model EscalationRule {
  id              String   @id @default(cuid())
  name            String?
  eventType       String   @map("event_type") // OVERDUE_AR, COMPLAINT_UNRESOLVED, ORDER_STUCK
  thresholdValue  Int      @map("threshold_value") // days, amount, etc.
  thresholdUnit   String   @map("threshold_unit") // DAYS, VND, COUNT
  recipientRole   UserRole @map("recipient_role")
  notifyChannels  String[] @map("notify_channels") // APP_PUSH, EMAIL
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([eventType, isActive])
  @@map("escalation_rules")
}

// ============================================
// REVENUE TARGET — Monthly revenue targets (BGD-1)
// ============================================

model RevenueTarget {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  branch    Branch
  target    Decimal  @db.Decimal(18, 2)
  setBy     String?  @map("set_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([year, month, branch])
  @@map("revenue_targets")
}

// ============================================
// RESPONSE TEMPLATE — Pre-built response library (CSKH-3)
// ============================================

model ResponseTemplate {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   // SHIPPING, PRICING, TRACKING, PAYMENT, GENERAL
  tags        String[]
  usageCount  Int      @default(0) @map("usage_count")
  isApproved  Boolean  @default(false) @map("is_approved")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("response_templates")
}

// ============================================
// GENERATED REPORT — Scheduled report output cache
// ============================================

model GeneratedReport {
  id          String   @id @default(uuid())
  type        String   // DAILY_REVENUE, DAILY_CONTAINER_TRACKING, WEEKLY_AR_AGING, MONTHLY_COMMISSION
  date        DateTime @db.Date
  data        Json
  filePath    String?
  generatedAt DateTime
  createdAt   DateTime @default(now())

  @@index([type, date])
  @@map("generated_reports")
}

