// ============================================
// FINANCE — AR, AP, Cash, Invoice, Payment Voucher
// ============================================

model AccountReceivable {
  id            String   @id @default(cuid())
  code          String   @unique            // Mã: TBS-AR-000001
  customerId    String   @map("customer_id")
  orderId       String?  @map("order_id")
  amount        Decimal  @db.Decimal(18, 2)
  paidAmount    Decimal  @default(0) @map("paid_amount") @db.Decimal(18, 2)
  currency      Currency @default(VND)
  dueDate       DateTime @map("due_date")
  status        AccountStatus @default(OPEN)
  nettedAmount  Decimal  @default(0) @map("netted_amount") @db.Decimal(18, 2)
  note          String?
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer      Customer @relation(fields: [customerId], references: [id])
  order         Order?   @relation(fields: [orderId], references: [id])

  @@index([customerId, status])
  @@index([dueDate])
  @@index([orderId])
  @@map("account_receivables")
}

model AccountPayable {
  id            String   @id @default(cuid())
  code          String   @unique
  vendorId      String?  @map("vendor_id")
  vendorName    String   @map("vendor_name")
  amount        Decimal  @db.Decimal(18, 2)
  paidAmount    Decimal  @default(0) @map("paid_amount") @db.Decimal(18, 2)
  currency      Currency @default(VND)
  dueDate       DateTime @map("due_date")
  status        AccountStatus @default(OPEN)
  nettedAmount  Decimal  @default(0) @map("netted_amount") @db.Decimal(18, 2)
  note          String?
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([vendorId, status])
  @@index([dueDate])
  @@map("account_payables")
}

model PaymentVoucher {
  id              String         @id @default(cuid())
  code            String         @unique
  type            VoucherType
  orderId         String?        @map("order_id") // Optional - có thể phân bổ cho hợp đồng
  contractId      String?        @map("contract_id")
  supplierOrderId String?        @map("supplier_order_id") // Liên kết trực tiếp với đơn mua hàng NCC
  amount          Decimal        @db.Decimal(18, 2)
  currency        Currency       @default(VND)
  paymentMethod   PaymentMethod  @map("payment_method")
  costType        String         @map("cost_type")       // Loại chi phí (dropdown)
  beneficiary     String                                  // Người thụ hưởng
  reason          String                                  // Lý do (≥ 20 ký tự)
  attachments     String[]       @default([])             // URLs chứng từ
  status          ApprovalStatus @default(PENDING)
  approvedBy      String?        @map("approved_by")
  approvedAt      DateTime?      @map("approved_at")
  isFlagged       Boolean        @default(false) @map("is_flagged")
  flagReason      String?        @map("flag_reason")
  createdBy       String         @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  order           Order?         @relation(fields: [orderId], references: [id])
  contract        Contract?      @relation(fields: [contractId], references: [id])
  supplierOrder   SupplierOrder? @relation(fields: [supplierOrderId], references: [id])
  allocations     PaymentAllocation[]

  @@index([orderId])
  @@index([contractId])
  @@index([supplierOrderId])
  @@index([createdBy])
  @@index([status])
  @@index([createdAt])
  @@map("payment_vouchers")
}

model CashTransaction {
  id            String        @id @default(cuid())
  voucherId     String?       @map("voucher_id")
  type          CashTransactionType
  amount        Decimal       @db.Decimal(18, 2)
  currency      Currency      @default(VND)
  paymentMethod PaymentMethod @map("payment_method")
  reference     String?
  note          String?
  createdBy     String        @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([voucherId])
  @@map("cash_transactions")
}

model Invoice {
  id              String   @id @default(cuid())
  code            String   @unique
  orderId         String?  @map("order_id")
  customerId      String   @map("customer_id")
  type            InvoiceType @default(GTGT)
  amount          Decimal  @db.Decimal(18, 2)
  taxRate         Decimal  @default(0.1) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount       Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount     Decimal  @map("total_amount") @db.Decimal(18, 2)
  status          InvoiceStatus @default(DRAFT)
  issuedAt        DateTime? @map("issued_at")
  sentToTaxAt     DateTime? @map("sent_to_tax_at")
  externalId      String?  @map("external_id") // Mã từ MISA/Viettel
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  items       InvoiceItem[]

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  from      Currency
  to        Currency
  rate      Decimal  @db.Decimal(18, 4)
  source    String   @default("VIETCOMBANK")
  date      DateTime @db.Date
  setBy       String?  @map("set_by")
  approvedBy  String?  @map("approved_by")
  isManual    Boolean  @default(false) @map("is_manual")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([from, to, date])
  @@map("exchange_rates")
}

model DebtNetting {
  id              String   @id @default(cuid())
  code            String   @unique
  partnerId       String   @map("partner_id")
  partnerName     String   @map("partner_name")
  arAmount        Decimal  @map("ar_amount") @db.Decimal(18, 2)
  apAmount        Decimal  @map("ap_amount") @db.Decimal(18, 2)
  netAmount       Decimal  @map("net_amount") @db.Decimal(18, 2)
  status          ApprovalStatus @default(PENDING)
  approvedBy      String?  @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  executedAt      DateTime? @map("executed_at")
  executedBy      String?  @map("executed_by")
  note            String?
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  items           DebtNettingItem[]

  @@index([status])
  @@index([partnerId])
  @@map("debt_nettings")
}

model ChartOfAccount {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        AccountType
  parentCode  String?
  level       Int      @default(1)
  isActive    Boolean  @default(true)
  entries     JournalEntryLine[]
  createdAt   DateTime @default(now())

  @@map("chart_of_accounts")
}

model JournalEntry {
  id          String   @id @default(cuid())
  code        String   @unique
  date        DateTime
  description String
  reference   String?  // Source document reference
  periodYear  Int
  periodMonth Int
  isPosted    Boolean  @default(false)
  lines       JournalEntryLine[]
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([periodYear, periodMonth])
  @@index([date])
  @@map("journal_entries")
}

model JournalEntryLine {
  id          String         @id @default(cuid())
  entryId     String
  entry       JournalEntry   @relation(fields: [entryId], references: [id])
  accountCode String
  account     ChartOfAccount @relation(fields: [accountCode], references: [code])
  debit       Decimal        @default(0) @db.Decimal(18, 2)
  credit      Decimal        @default(0) @db.Decimal(18, 2)
  description String?

  @@index([entryId])
  @@index([accountCode])
  @@map("journal_entry_lines")
}

model CommissionRule {
  id          String      @id @default(cuid())
  serviceType ServiceType
  minProfit   Decimal     @db.Decimal(18, 2)
  maxProfit   Decimal     @db.Decimal(18, 2)
  rate        Decimal     @db.Decimal(5, 4) // 0.0 to 1.0
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("commission_rules")
}

model CommissionRecord {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  saleId      String
  sale        User     @relation("SaleCommissions", fields: [saleId], references: [id])
  orderRevenue     Decimal  @db.Decimal(18, 2)
  orderCost        Decimal  @db.Decimal(18, 2)
  netProfit        Decimal  @db.Decimal(18, 2)
  commissionRate   Decimal  @db.Decimal(5, 4)
  commissionAmount Decimal  @db.Decimal(18, 2)
  status      CommissionStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  paidAt      DateTime?

  // Clawback fields
  clawbackAmount      Decimal?  @map("clawback_amount") @db.Decimal(18, 2)
  clawbackReason      String?   @map("clawback_reason")
  clawbackComplaintId String?   @map("clawback_complaint_id")
  clawbackAt          DateTime? @map("clawback_at")

  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([saleId])
  @@index([status])
  @@map("commission_records")
}

model PurchaseRequest {
  id          String         @id @default(cuid())
  code        String         @unique
  vendorId    String?
  orderId     String?
  status      PurchaseStatus @default(DRAFT)
  totalAmount Decimal        @default(0) @db.Decimal(18, 2)
  currency    Currency       @default(VND)
  notes       String?
  items       PurchaseRequestItem[]
  vendor      Vendor?        @relation("PurchaseRequestVendor", fields: [vendorId], references: [id])
  createdBy   String
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([vendorId])
  @@index([orderId])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id          String          @id @default(cuid())
  requestId   String
  request     PurchaseRequest @relation(fields: [requestId], references: [id])
  description String
  quantity    Decimal         @db.Decimal(15, 3)
  unit        String
  unitPrice   Decimal         @db.Decimal(18, 2)
  amount      Decimal         @db.Decimal(18, 2)

  @@index([requestId])
  @@map("purchase_request_items")
}

model PurchaseOrder {
  id          String         @id @default(cuid())
  code        String         @unique
  prId        String?        // Linked PR
  vendorId    String
  orderId     String?
  status      PurchaseStatus @default(DRAFT)
  totalAmount Decimal        @default(0) @db.Decimal(18, 2)
  currency    Currency       @default(CNY)
  notes       String?
  vendor      Vendor         @relation("PurchaseOrderVendor", fields: [vendorId], references: [id])
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([orderId])
  @@map("purchase_orders")
}

model StockItem {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  unit        String
  category    String?
  currentQty  Decimal         @default(0) @db.Decimal(15, 3)
  minLevel    Decimal         @default(0) @db.Decimal(15, 3)
  maxLevel    Decimal         @default(0) @db.Decimal(15, 3)
  location    String?
  movements   StockMovement[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("stock_items")
}

model StockMovement {
  id          String            @id @default(cuid())
  itemId      String
  item        StockItem         @relation(fields: [itemId], references: [id])
  type        StockMovementType
  quantity    Decimal           @db.Decimal(15, 3)
  reference   String?
  notes       String?
  createdBy   String
  createdAt   DateTime          @default(now())

  @@index([itemId])
  @@index([type])
  @@map("stock_movements")
}

model CODRecord {
  id          String    @id @default(cuid())
  deliveryId  String
  amount      Decimal   @db.Decimal(18, 2)
  collectedAmount Decimal @default(0) @db.Decimal(18, 2)
  status      CODStatus @default(PENDING)
  paymentMethod String?
  driverId    String
  collectedAt DateTime?
  remittedAt  DateTime?
  shortage    Decimal   @default(0) @db.Decimal(18, 2)
  notes       String?
  photoUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  delivery    Delivery  @relation(fields: [deliveryId], references: [id])
  driver      Driver?   @relation(fields: [driverId], references: [id])

  @@index([deliveryId])
  @@index([driverId])
  @@index([status])
  @@map("cod_records")
}

model ClosedPeriod {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  closedBy  String   @map("closed_by")
  closedAt  DateTime @default(now()) @map("closed_at")

  @@unique([year, month])
  @@map("closed_periods")
}

model DebtNettingItem {
  id          String @id @default(cuid())
  nettingId   String @map("netting_id")
  type        DebtNettingItemType
  referenceId String @map("reference_id")
  amount      Decimal @db.Decimal(18, 2)

  netting     DebtNetting @relation(fields: [nettingId], references: [id], onDelete: Cascade)

  @@index([nettingId])
  @@map("debt_netting_items")
}

// ============================================
// PAYMENT ALLOCATION — Phân bổ thanh toán
// ============================================

model PaymentAllocation {
  id              String              @id @default(cuid())
  code            String              @unique        // PA-000001

  // Nguồn: Tiền đến từ đâu
  sourceType      PaymentSourceType   @map("source_type")
  sourceId        String              @map("source_id") // voucherId hoặc walletTransactionId
  sourceReference String?             @map("source_reference")
  voucherId       String?             @map("voucher_id")

  // Đích: Hợp đồng hoặc Đơn hàng
  targetType      PaymentTargetType   @map("target_type")
  contractId      String?             @map("contract_id")
  orderId         String?             @map("order_id")

  totalAmount     Decimal             @map("total_amount") @db.Decimal(18, 2)
  allocatedAmount Decimal             @default(0) @map("allocated_amount") @db.Decimal(18, 2)
  currency        Currency            @default(VND)

  purposeType     PaymentPurpose      @map("purpose_type") // DEPOSIT, SETTLEMENT, REFUND
  note            String?

  allocatedBy     String              @map("allocated_by")
  allocatedAt     DateTime            @default(now()) @map("allocated_at")
  isReversed      Boolean             @default(false) @map("is_reversed")
  reversedAt      DateTime?           @map("reversed_at")
  reversalReason  String?             @map("reversal_reason")

  contract        Contract?           @relation(fields: [contractId], references: [id])
  order           Order?              @relation(fields: [orderId], references: [id])
  voucher         PaymentVoucher?     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  details         PaymentAllocationDetail[]

  @@index([contractId])
  @@index([orderId])
  @@index([voucherId])
  @@index([sourceType, sourceId])
  @@map("payment_allocations")
}

model PaymentAllocationDetail {
  id              String              @id @default(cuid())
  allocationId    String              @map("allocation_id")
  arId            String?             @map("ar_id") // Liên kết đến AccountReceivable
  description     String
  amount          Decimal             @db.Decimal(18, 2)
  createdAt       DateTime            @default(now()) @map("created_at")

  allocation      PaymentAllocation   @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@index([allocationId])
  @@index([arId])
  @@map("payment_allocation_details")
}

enum PaymentSourceType {
  PAYMENT_VOUCHER      // Từ PaymentVoucher (chuyển khoản, tiền mặt)
  WALLET_TOPUP         // Từ WalletTransaction (khách nạp trước)
  CREDIT_NOTE          // Từ phiếu ghi có/hoàn tiền
}

enum PaymentTargetType {
  CONTRACT             // Phân bổ cho toàn bộ hợp đồng
  ORDER                // Phân bổ cho đơn hàng cụ thể
}

enum PaymentPurpose {
  DEPOSIT              // Tiền cọc ban đầu
  SETTLEMENT           // Thanh toán cuối cùng (thanh lý)
  INSTALLMENT          // Thanh toán trả góp
  REFUND               // Hoàn tiền cho khách
  ADJUSTMENT           // Điều chỉnh
}

// ============================================
// AR AGING SNAPSHOTS — Historical aging tracking
// ============================================

model ARAgingSnapshot {
  id              String   @id @default(cuid())
  snapshotDate    DateTime @map("snapshot_date")
  customerId      String?  @map("customer_id")

  // Aging buckets (all amounts in VND)
  current         Decimal  @default(0) @db.Decimal(18, 2)  // Not due yet
  days1_30        Decimal  @default(0) @map("days_1_30") @db.Decimal(18, 2)
  days31_60       Decimal  @default(0) @map("days_31_60") @db.Decimal(18, 2)
  days61_90       Decimal  @default(0) @map("days_61_90") @db.Decimal(18, 2)
  days90Plus      Decimal  @default(0) @map("days_90_plus") @db.Decimal(18, 2)

  // Aggregates
  totalOutstanding Decimal  @map("total_outstanding") @db.Decimal(18, 2)
  totalOverdue    Decimal  @map("total_overdue") @db.Decimal(18, 2)
  maxOverdueDays  Int      @default(0) @map("max_overdue_days")

  // Counts
  countCurrent    Int      @default(0) @map("count_current")
  count1_30       Int      @default(0) @map("count_1_30")
  count31_60      Int      @default(0) @map("count_31_60")
  count61_90      Int      @default(0) @map("count_61_90")
  count90Plus     Int      @default(0) @map("count_90_plus")

  // Risk indicators
  riskLevel       RiskLevel @default(LOW) @map("risk_level")

  shouldBlock     Boolean  @default(false) @map("should_block")
  blockReason     String?  @map("block_reason")

  createdAt       DateTime @default(now()) @map("created_at")

  customer        Customer? @relation(fields: [customerId], references: [id])

  @@index([snapshotDate])
  @@index([customerId, snapshotDate])
  @@index([riskLevel])
  @@map("ar_aging_snapshots")
}

// ============================================
// FINANCE ENUMS
// ============================================

enum AccountStatus {
  OPEN
  PARTIAL
  PAID
  OVERDUE
  NETTED
  CANCELLED
}

enum VoucherType {
  RECEIPT
  PAYMENT
}

enum CashTransactionType {
  IN
  OUT
}

enum InvoiceType {
  GTGT
  DIEU_CHINH
  HUY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT_TAX
  CANCELLED
  ADJUSTED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  ON_HOLD
  CANCELLED
}

enum DebtNettingItemType {
  AR
  AP
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================
// TAX TYPE — Loại thuế cho hóa đơn điện tử
// ============================================

enum TaxType {
  NO_TAX
  ZERO_PERCENT
  EIGHT_PERCENT
  TEN_PERCENT
}

// ============================================
// INVOICE ITEM — Chi tiết hóa đơn với thuế riêng
// ============================================

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String   @map("invoice_id")
  description String
  quantity    Decimal  @db.Decimal(15, 3)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(18, 2)
  amount      Decimal  @db.Decimal(18, 2)
  taxType     TaxType  @map("tax_type")
  taxAmount   Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 2)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ============================================
// UNALLOCATED FUND CLAIM — Nhận vơ tiền chưa phân bổ
// ============================================

model UnallocatedFundClaim {
  id                  String         @id @default(cuid())
  walletTransactionId String         @map("wallet_transaction_id")
  customerId          String         @map("customer_id")
  claimedBySaleId     String         @map("claimed_by_sale_id")
  amount              Decimal        @db.Decimal(18, 2)
  evidence            String[]       @default([])
  targetOrderId       String?        @map("target_order_id")
  targetContractId    String?        @map("target_contract_id")
  status              ApprovalStatus @default(PENDING)
  approvedBy          String?        @map("approved_by")
  approvedAt          DateTime?      @map("approved_at")
  note                String?
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([status])
  @@map("unallocated_fund_claims")
}
