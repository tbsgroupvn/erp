// ============================================
// HR — Employee, Attendance, Leave, Payroll
// ============================================

model Employee {
  id              String         @id @default(cuid())
  code            String         @unique
  userId          String?        @unique
  user            User?          @relation(fields: [userId], references: [id])
  fullName        String
  email           String?
  phone           String?
  departmentCode  String
  positionTitle   String
  branch          Branch
  managerId       String?
  manager         Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates    Employee[]     @relation("EmployeeManager")
  joinDate        DateTime
  salary          Decimal?       @db.Decimal(18, 2)
  /// @encrypted
  bankName        String?
  /// @encrypted
  bankAccount     String?
  /// @encrypted
  taxCode         String?
  /// @encrypted
  insuranceId     String?
  numberOfDependents Int        @default(0)
  status          EmployeeStatus @default(ACTIVE)
  attendances     Attendance[]
  leaveRequests   LeaveRequest[]
  payrollRecords     PayrollRecord[]
  overtimeRequests   OvertimeRequest[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([departmentCode])
  @@index([branch])
  @@index([status])
  @@index([email])
  @@map("employees")
}

model Attendance {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  checkInLat  Float?
  checkInLng  Float?
  checkOutLat Float?
  checkOutLng Float?
  type        AttendanceType @default(OFFICE)
  workHours   Float?
  overtimeHours Float? @default(0)
  isLate      Boolean  @default(false)
  notes       String?

  // Manual check-in fields
  selfieUrl         String?  @map("selfie_url")
  manualReason      String?  @map("manual_reason")
  isManualCheckIn   Boolean  @default(false) @map("is_manual_check_in")
  hrReviewStatus    String?  @map("hr_review_status") // PENDING_REVIEW | APPROVED | REJECTED
  hrReviewedBy      String?  @map("hr_reviewed_by")
  hrReviewedAt      DateTime? @map("hr_reviewed_at")

  createdAt   DateTime @default(now())

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([employeeId, date])
  @@map("attendances")
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        LeaveType
  status      LeaveStatus @default(PENDING)
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  totalDays   Float
  reason      String?
  approvedBy  String?
  approvedAt  DateTime?
  rejectionReason String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([employeeId, status])
  @@map("leave_requests")
}

model OvertimeRequest {
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id])
  date         DateTime    @db.Date
  hours        Float
  reason       String?
  status       LeaveStatus @default(PENDING)
  approverId   String?
  approvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([employeeId])
  @@index([date])
  @@map("overtime_requests")
}

model PayrollRecord {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month        Int
  year         Int
  baseSalary         Decimal  @db.Decimal(18, 2)
  overtimePay        Decimal  @default(0) @db.Decimal(18, 2)
  allowances         Decimal  @default(0) @db.Decimal(18, 2)
  grossSalary        Decimal  @db.Decimal(18, 2)
  taxDeduction       Decimal  @default(0) @db.Decimal(18, 2)
  insuranceDeduction Decimal  @default(0) @db.Decimal(18, 2)
  otherDeductions    Decimal  @default(0) @db.Decimal(18, 2)
  netSalary          Decimal  @db.Decimal(18, 2)
  status       PayrollStatus @default(DRAFT)
  approvedBy   String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime @default(now())

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([month, year])
  @@index([employeeId, month, year])
  @@map("payroll_records")
}

// ============================================
// HR ENUMS
// ============================================

enum AttendanceType {
  OFFICE
  REMOTE
  FIELD
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}
