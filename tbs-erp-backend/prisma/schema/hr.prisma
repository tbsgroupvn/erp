// ============================================
// HR — Employee, Attendance, Leave, Payroll
// ============================================

model Employee {
  id              String         @id @default(cuid())
  code            String         @unique
  userId          String?        @unique
  user            User?          @relation(fields: [userId], references: [id])
  fullName        String
  email           String?        @unique
  phone           String?
  departmentCode  String
  positionTitle   String
  branch          Branch
  managerId       String?
  manager         Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates    Employee[]     @relation("EmployeeManager")
  joinDate        DateTime
  salary          Decimal?       @db.Decimal(18, 2)
  /// @encrypted
  bankName        String?
  /// @encrypted
  bankAccount     String?
  /// @encrypted
  taxCode         String?
  /// @encrypted
  insuranceId     String?
  numberOfDependents Int        @default(0)
  status          EmployeeStatus @default(ACTIVE)
  attendances     Attendance[]
  leaveRequests   LeaveRequest[]
  payrollRecords     PayrollRecord[]
  overtimeRequests   OvertimeRequest[]
  trainingRecords    TrainingRecord[]
  onboardingChecklists OnboardingChecklist[]
  performanceNotes   PerformanceNote[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([departmentCode])
  @@index([branch])
  @@index([status])
  @@index([email])
  @@index([managerId])
  @@map("employees")
}

model Attendance {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  checkInLat  Float?
  checkInLng  Float?
  checkOutLat Float?
  checkOutLng Float?
  type        AttendanceType @default(OFFICE)
  workHours   Decimal?  @db.Decimal(5, 2)
  overtimeHours Decimal? @default(0) @db.Decimal(5, 2)
  isLate      Boolean  @default(false)
  notes       String?

  // Manual check-in fields
  selfieUrl         String?  @map("selfie_url")
  manualReason      String?  @map("manual_reason")
  isManualCheckIn   Boolean  @default(false) @map("is_manual_check_in")
  hrReviewStatus    String?  @map("hr_review_status") // PENDING_REVIEW | APPROVED | REJECTED
  hrReviewedBy      String?  @map("hr_reviewed_by")
  hrReviewedAt      DateTime? @map("hr_reviewed_at")

  location    AttendanceLocation?

  createdAt   DateTime @default(now())

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([employeeId, date])
  @@map("attendances")
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        LeaveType
  status      LeaveStatus @default(PENDING)
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  totalDays   Decimal   @db.Decimal(5, 2)
  reason      String?
  approvedBy  String?
  approvedAt  DateTime?
  rejectionReason String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([employeeId, status])
  @@map("leave_requests")
}

model OvertimeRequest {
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime    @db.Date
  hours        Decimal  @db.Decimal(5, 2)
  reason       String?
  status       LeaveStatus @default(PENDING)
  approverId   String?
  approvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([employeeId])
  @@index([date])
  @@map("overtime_requests")
}

model PayrollRecord {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month        Int
  year         Int
  baseSalary         Decimal  @db.Decimal(18, 2)
  overtimePay        Decimal  @default(0) @db.Decimal(18, 2)
  allowances         Decimal  @default(0) @db.Decimal(18, 2)
  grossSalary        Decimal  @db.Decimal(18, 2)
  taxDeduction       Decimal  @default(0) @db.Decimal(18, 2)
  insuranceDeduction Decimal  @default(0) @db.Decimal(18, 2)
  otherDeductions    Decimal  @default(0) @db.Decimal(18, 2)
  netSalary          Decimal  @db.Decimal(18, 2)
  status       PayrollStatus @default(DRAFT)
  approvedBy   String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime @default(now())

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([month, year])
  @@index([employeeId, month, year])
  @@map("payroll_records")
}

// ============================================
// HR ENUMS
// ============================================

enum AttendanceType {
  OFFICE
  REMOTE
  FIELD
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

// ============================================
// TRAINING RECORD — Employee training history (NS-4)
// ============================================

model TrainingRecord {
  id              String    @id @default(cuid())
  employeeId      String    @map("employee_id")
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseName      String    @map("course_name")
  provider        String?
  completedAt     DateTime  @map("completed_at")
  certificateUrl  String?   @map("certificate_url")
  certificateExpiry DateTime? @map("certificate_expiry")
  note            String?
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([employeeId])
  @@map("training_records")
}

// ============================================
// CANDIDATE — Recruitment pipeline (NS-1)
// ============================================

model Candidate {
  id          String   @id @default(cuid())
  fullName    String   @map("full_name")
  phone       String?
  email       String?
  position    String   // Vị trí ứng tuyển
  status      String   @default("NEW") // NEW, SCREENING, INTERVIEW, OFFERED, HIRED, REJECTED
  source      String?  // WEBSITE, REFERRAL, JOB_BOARD
  resumeUrl   String?  @map("resume_url")
  notes       String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("candidates")
}

// ============================================
// ONBOARDING CHECKLIST — Employee onboarding/offboarding (NS-2)
// ============================================

model OnboardingChecklist {
  id          String    @id @default(cuid())
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        String    // ONBOARDING | OFFBOARDING
  items       Json      // [{ "task": "Create account", "completed": true, "completedAt": "...", "completedBy": "..." }]
  completedAt DateTime? @map("completed_at")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([employeeId])
  @@map("onboarding_checklists")
}

// ============================================
// EXPENSE CLAIM — Employee expense reports (NS-5)
// ============================================

model ExpenseClaim {
  id           String   @id @default(cuid())
  code         String   @unique // EXP-XXXX
  employeeId   String   @map("employee_id")
  title        String
  description  String?
  totalAmount  Decimal  @default(0) @db.Decimal(18, 2) @map("total_amount")
  currency     String   @default("VND")
  status       String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED, PAID
  submittedAt  DateTime? @map("submitted_at")
  approvedBy   String?  @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  rejectionReason String? @map("rejection_reason")
  paidAt       DateTime? @map("paid_at")
  items        ExpenseItem[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([employeeId])
  @@index([status])
  @@map("expense_claims")
}

model ExpenseItem {
  id            String   @id @default(cuid())
  expenseClaimId String  @map("expense_claim_id")
  expenseClaim  ExpenseClaim @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)
  category      String   // TRAVEL, MEAL, TRANSPORT, OFFICE, PHONE, OTHER
  description   String
  amount        Decimal  @db.Decimal(18, 2)
  date          DateTime @db.Date
  receiptUrl    String?  @map("receipt_url")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([expenseClaimId])
  @@map("expense_items")
}

// ============================================
// PERFORMANCE NOTE — Employee evaluations (NS-3)
// ============================================

model PerformanceNote {
  id          String   @id @default(cuid())
  employeeId  String   @map("employee_id")
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period      String   // "2026-Q1", "2026-H1"
  rating      Int?     // 1-5
  strengths   String?
  improvements String?
  goals       String?
  reviewedBy  String   @map("reviewed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([employeeId])
  @@map("performance_notes")
}
