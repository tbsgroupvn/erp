// ─────────────────────────────────────────────────────────────
// Content Management System (CMS)
// ─────────────────────────────────────────────────────────────

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

enum MenuLocation {
  HEADER
  FOOTER
  SIDEBAR
  MOBILE
}

/// CMS Pages for static content (About, Contact, Services, etc.)
model Page {
  id              String     @id @default(cuid())
  slug            String     @unique @db.VarChar(255)
  title           String     @db.VarChar(500)
  content         String     @db.Text
  excerpt         String?    @db.VarChar(1000)

  // SEO Fields
  metaTitle       String?    @db.VarChar(255)
  metaDescription String?    @db.VarChar(500)
  metaKeywords    String[]   @default([])
  ogImage         String?    @db.VarChar(500)

  // Layout & Display
  template        String     @default("default") @db.VarChar(100)
  featuredImage   String?    @db.VarChar(500)
  status          PageStatus @default(DRAFT)

  // Hierarchy
  parentId        String?
  parent          Page?      @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Page[]     @relation("PageHierarchy")
  order           Int        @default(0)

  // Author & Timestamps
  authorId        String
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([slug])
  @@index([status, publishedAt(sort: Desc)])
  @@index([parentId])
  @@map("cms_pages")
}

/// Media Library for managing uploads
model Media {
  id           String    @id @default(cuid())
  filename     String    @db.VarChar(255)
  originalName String    @db.VarChar(255)
  mimeType     String    @db.VarChar(100)
  size         Int       // in bytes
  type         MediaType

  // File paths
  path         String    @db.VarChar(500) // Full path to file
  url          String    @db.VarChar(500) // Public URL
  thumbnailUrl String?   @db.VarChar(500) // For images/videos

  // Metadata
  width        Int?      // For images
  height       Int?      // For images
  duration     Int?      // For videos/audio (in seconds)
  alt          String?   @db.VarChar(255)
  caption      String?   @db.VarChar(500)

  // Organization
  folder       String?   @db.VarChar(255)
  tags         String[]  @default([])

  // Upload info
  uploadedBy   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([type])
  @@index([folder])
  @@index([tags])
  @@index([uploadedBy])
  @@map("cms_media")
}

/// Menu Management for dynamic navigation
model Menu {
  id          String       @id @default(cuid())
  name        String       @db.VarChar(255)
  location    MenuLocation
  isActive    Boolean      @default(true)
  items       MenuItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([name, location])
  @@index([location, isActive])
  @@map("cms_menus")
}

/// Menu Items with hierarchy
model MenuItem {
  id        String     @id @default(cuid())
  menuId    String
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)

  // Item details
  label     String     @db.VarChar(255)
  url       String     @db.VarChar(500)
  icon      String?    @db.VarChar(100)
  target    String     @default("_self") @db.VarChar(20) // _self, _blank

  // Hierarchy
  parentId  String?
  parent    MenuItem?  @relation("MenuItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  MenuItem[] @relation("MenuItemHierarchy")
  order     Int        @default(0)

  // Visibility
  isVisible Boolean    @default(true)
  roles     String[]   @default([]) // Empty = all users, or specify roles

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([menuId, order])
  @@index([parentId])
  @@map("cms_menu_items")
}

/// Site Settings (Key-Value store)
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(255)
  value     String   @db.Text
  type      String   @db.VarChar(50) // string, number, boolean, json, image
  group     String   @db.VarChar(100) // general, contact, social, seo, etc.
  label     String   @db.VarChar(255)
  hint      String?  @db.VarChar(500)
  order     Int      @default(0)
  isPublic  Boolean  @default(false) // Can be accessed without auth
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group, order])
  @@index([isPublic])
  @@map("cms_settings")
}

/// SEO Redirects for URL management
model Redirect {
  id          String   @id @default(cuid())
  fromPath    String   @unique @db.VarChar(500)
  toPath      String   @db.VarChar(500)
  statusCode  Int      @default(301) // 301 or 302
  isActive    Boolean  @default(true)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fromPath])
  @@index([isActive])
  @@map("cms_redirects")
}

/// Contact Form Submissions
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  subject   String   @db.VarChar(500)
  message   String   @db.Text

  // Metadata
  ip        String?  @db.VarChar(50)
  userAgent String?  @db.VarChar(500)
  referrer  String?  @db.VarChar(500)

  // Status
  isRead    Boolean  @default(false)
  isReplied Boolean  @default(false)
  notes     String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead, createdAt(sort: Desc)])
  @@index([email])
  @@map("cms_contact_submissions")
}

/// Newsletter Subscriptions
model NewsletterSubscription {
  id            String   @id @default(cuid())
  email         String   @unique @db.VarChar(255)
  name          String?  @db.VarChar(255)
  status        String   @default("active") @db.VarChar(50) // active, unsubscribed
  source        String?  @db.VarChar(100) // homepage, blog, popup
  unsubscribeToken String? @unique @db.VarChar(100)
  subscribedAt  DateTime @default(now())
  unsubscribedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@map("cms_newsletter_subscriptions")
}

/// FAQs
model FAQ {
  id        String   @id @default(cuid())
  question  String   @db.VarChar(500)
  answer    String   @db.Text
  category  String   @db.VarChar(100)
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
  @@index([isActive])
  @@map("cms_faqs")
}
