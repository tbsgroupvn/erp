// ============================================
// LOGISTICS — Fleet, Driver, Delivery, COD
// ============================================

enum DeliveryStatus {
  PENDING
  DISPATCHED
  PICKED_UP
  DELIVERING
  DELIVERED
  FAILED
  RETURN_TO_ORIGIN
  RTO_RECEIVED
}

model Vehicle {
  id                String        @id @default(cuid())
  plateNumber       String        @unique @map("plate_number")
  type              VehicleType
  brand             String?
  model             String?
  year              Int?
  capacityKg        Decimal?  @db.Decimal(10, 2)
  volumeM3          Decimal?  @db.Decimal(10, 3)
  status            VehicleStatus @default(ACTIVE)
  branch            Branch
  insuranceExpiry   DateTime?
  registrationExpiry DateTime?
  maintenanceRecords VehicleMaintenance[]
  fuelRecords       FuelRecord[]
  deliveries        Delivery[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([branch])
  @@map("vehicles")
}

model Driver {
  id            String       @id @default(cuid())
  employeeId    String?
  fullName      String
  phone         String
  licenseNumber String?      @unique
  licenseExpiry DateTime?
  licenseType   String?
  vehicleId     String?
  branch        Branch
  status        DriverStatus @default(AVAILABLE)
  deliveries    Delivery[]
  codRecords    CODRecord[]

  // COD enforcement
  isCODBlocked    Boolean    @default(false) @map("is_cod_blocked")
  codBlockedAt    DateTime?  @map("cod_blocked_at")

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([branch])
  @@map("drivers")
}

model Delivery {
  id              String   @id @default(cuid())
  code            String   @unique
  orderId         String   @map("order_id")
  driverId        String?  @map("driver_id")
  vehicleId       String?  @map("vehicle_id")
  branch          Branch

  // Dia chi giao
  recipientName   String   @map("recipient_name")
  recipientPhone  String   @map("recipient_phone")
  deliveryAddress String   @map("delivery_address")

  // Trang thai
  status          DeliveryStatus @default(PENDING)
  scheduledAt     DateTime? @map("scheduled_at")
  pickedUpAt      DateTime? @map("picked_up_at")
  deliveredAt     DateTime? @map("delivered_at")
  podImageUrl     String?  @map("pod_image_url")   // Proof of Delivery
  signatureUrl    String?  @map("signature_url")
  deliveryProofUrls String[] @default([]) @map("delivery_proof_urls") // Multiple POD photos

  // COD
  codAmount       Decimal  @default(0) @map("cod_amount") @db.Decimal(18, 2)
  codCollected    Boolean  @default(false) @map("cod_collected")
  codCollectedAt  DateTime? @map("cod_collected_at")
  codReceiptUrl   String?  @map("cod_receipt_url")

  failReason      String?  @map("fail_reason")

  // RTO fields
  rtoReason       String?  @map("rto_reason")
  rtoReceivedAt   DateTime? @map("rto_received_at")
  rtoStorageFee   Decimal? @map("rto_storage_fee") @db.Decimal(18, 2)
  rtoStorageDays  Int?     @map("rto_storage_days")

  // Partial delivery
  isPartialDelivery Boolean @default(false) @map("is_partial_delivery")

  // Hang van chuyen noi dia
  carrierTrackingNumber String?  @map("carrier_tracking_number")
  carrierName           String?  @map("carrier_name")

  note            String?
  dispatchedBy    String?  @map("dispatched_by")  // Truong kho
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver          Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  codRecords      CODRecord[]
  deliveryPackages DeliveryPackage[]

  @@index([orderId])
  @@index([driverId])
  @@index([status])
  @@index([scheduledAt])
  @@index([orderId, status])
  @@index([branch, status])
  @@index([deliveredAt])
  @@index([vehicleId])
  @@index([carrierTrackingNumber])
  @@map("deliveries")
}

model DeliveryPackage {
  id          String   @id @default(cuid())
  deliveryId  String   @map("delivery_id")
  packageId   String   @map("package_id")

  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  package     Package  @relation(fields: [packageId], references: [id])

  @@unique([deliveryId, packageId])
  @@index([packageId])
  @@map("delivery_packages")
}

model VehicleMaintenance {
  id          String          @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        MaintenanceType
  scheduledDate DateTime
  completedDate DateTime?
  cost        Decimal?        @db.Decimal(18, 2)
  notes       String?
  nextDueDate DateTime?
  createdAt   DateTime        @default(now())

  @@index([vehicleId])
  @@map("vehicle_maintenances")
}

model FuelRecord {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date      DateTime
  liters    Decimal @db.Decimal(15, 3)
  cost      Decimal @db.Decimal(18, 2)
  odometer  Float?
  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([date])
  @@map("fuel_records")
}
