// ============================================
// INTEGRATION — Outbox, Reconciliation, Batch Jobs
// ============================================

// ─── OUTBOX PATTERN ───
// Ensures atomicity between DB writes and event publishing.
// Events are written to this table in the same transaction as
// the business operation, then a worker polls and dispatches them.

model OutboxEvent {
  id            String       @id @default(cuid())
  aggregateType String       @map("aggregate_type")   // 'Order', 'Payment', 'Package'
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type")       // 'order.completed', 'payment.received'
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(5) @map("max_attempts")
  lastError     String?      @map("last_error")
  processedAt   DateTime?    @map("processed_at")
  nextRetryAt   DateTime?    @map("next_retry_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
  DEAD_LETTER
}

// ─── PERSISTENT DEAD LETTER QUEUE ───
// Replaces the in-memory DLQ for events that failed processing.

model DeadLetterEvent {
  id          String   @id @default(cuid())
  event       String                             // Event name e.g. 'order.status.changed'
  payload     Json
  error       String
  source      String   @default("event_bus")     // 'event_bus', 'webhook', 'queue'
  retryCount  Int      @default(0) @map("retry_count")
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?  @map("resolved_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([event])
  @@index([resolvedAt])
  @@index([createdAt])
  @@map("dead_letter_events")
}

// ─── RECONCILIATION ───

model ReconciliationRun {
  id                String          @id @default(cuid())
  type              ReconType
  scope             String                        // e.g. '2026-02', customerId
  status            ReconRunStatus  @default(RUNNING)
  triggeredBy       String          @map("triggered_by") // 'CRON' | userId

  // Stats
  totalRecords      Int             @default(0) @map("total_records")
  matchedCount      Int             @default(0) @map("matched_count")
  discrepancyCount  Int             @default(0) @map("discrepancy_count")
  orphanedCount     Int             @default(0) @map("orphaned_count")

  // Source/target
  sourceSystem      String          @default("ERP") @map("source_system")
  targetSystem      String          @map("target_system")   // 'VCB_BANK', 'MISA', 'WAREHOUSE_CN'

  startedAt         DateTime        @default(now()) @map("started_at")
  completedAt       DateTime?       @map("completed_at")
  errorMessage      String?         @map("error_message")

  items             ReconciliationItem[]

  @@index([type, startedAt])
  @@index([status])
  @@index([triggeredBy])
  @@map("reconciliation_runs")
}

model ReconciliationItem {
  id                String           @id @default(cuid())
  runId             String           @map("run_id")
  run               ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  // References
  sourceId          String           @map("source_id")
  sourceReference   String           @map("source_reference")
  targetId          String?          @map("target_id")
  targetReference   String?          @map("target_reference")

  // Result
  status            ReconItemStatus  @default(PENDING)
  matchType         ReconMatchType?  @map("match_type")

  // Variance details
  sourceAmount      Decimal?         @map("source_amount") @db.Decimal(18, 2)
  targetAmount      Decimal?         @map("target_amount") @db.Decimal(18, 2)
  varianceAmount    Decimal?         @map("variance_amount") @db.Decimal(18, 2)
  variancePercent   Decimal?         @map("variance_percent") @db.Decimal(5, 2)

  // Resolution
  resolution        String?                       // AUTO_MATCHED, MANUAL_ADJUSTED, WRITTEN_OFF
  resolvedBy        String?          @map("resolved_by")
  resolvedAt        DateTime?        @map("resolved_at")
  note              String?

  createdAt         DateTime         @default(now()) @map("created_at")

  @@index([runId, status])
  @@index([sourceReference])
  @@map("reconciliation_items")
}

enum ReconType {
  FINANCIAL
  INVENTORY
  ORDER
  PAYMENT
}

enum ReconRunStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum ReconItemStatus {
  PENDING
  MATCHED
  DISCREPANCY
  ORPHANED_SOURCE
  ORPHANED_TARGET
  RESOLVED
}

enum ReconMatchType {
  EXACT
  PARTIAL
  AMOUNT_ONLY
  DATE_SHIFTED
  NONE
}

// ─── BATCH JOBS ───
// For long-running operations (reconciliation, import, export, sync).
// API returns 202 Accepted + jobId, client polls for progress.

model BatchJob {
  id                String         @id @default(cuid())
  type              String                           // 'RECON', 'IMPORT', 'EXPORT', 'SYNC'
  status            BatchJobStatus @default(QUEUED)
  parameters        Json                             // Input params

  // Progress
  totalRecords      Int            @default(0) @map("total_records")
  processedRecords  Int            @default(0) @map("processed_records")
  failedRecords     Int            @default(0) @map("failed_records")
  lastCheckpoint    String?        @map("last_checkpoint") // Resume point

  // Result
  resultUrl         String?        @map("result_url")      // Download URL
  errorSummary      String?        @map("error_summary")

  createdBy         String         @map("created_by")
  startedAt         DateTime?      @map("started_at")
  completedAt       DateTime?      @map("completed_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  @@index([status])
  @@index([type, createdAt])
  @@index([createdBy])
  @@map("batch_jobs")
}

enum BatchJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ─── SYNC LOG ───
// Audit trail for all inbound sync operations with idempotency key.

model SyncLog {
  id                String   @id @default(cuid())
  idempotencyKey    String   @unique @map("idempotency_key") // source:entity:externalId:hash
  source            String                           // 'SHOPEE', 'GHTK', 'VCB'
  entity            String                           // 'order', 'package', 'payment'
  externalId        String   @map("external_id")
  action            String                           // 'create', 'update', 'delete'
  status            String   @default("SUCCESS")     // 'SUCCESS', 'CONFLICT', 'FAILED'
  conflictsResolved Int      @default(0) @map("conflicts_resolved")
  payload           Json?
  errorMessage      String?  @map("error_message")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([source, entity])
  @@index([externalId])
  @@index([createdAt])
  @@map("sync_logs")
}
