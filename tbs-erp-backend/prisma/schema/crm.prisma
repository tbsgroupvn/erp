// ============================================
// CRM — Customer, Contact, Wallet
// ============================================

model Customer {
  id              String       @id @default(cuid())
  code            String       @unique            // Mã KH: TBS-KH-000001
  companyName     String?      @map("company_name")
  fullName        String       @map("full_name")
  phone           String
  email           String?
  address         String?
  taxCode         String?      @map("tax_code")
  tier            CustomerTier @default(NEW)
  creditLimit     Decimal      @default(0) @map("credit_limit") @db.Decimal(18, 2)
  currentDebt     Decimal      @default(0) @map("current_debt") @db.Decimal(18, 2)
  depositRate     Int          @default(100) @map("deposit_rate") // % cọc tối thiểu
  totalOrders     Int          @default(0) @map("total_orders")
  totalRevenue    Decimal      @default(0) @map("total_revenue") @db.Decimal(18, 2)
  branch          Branch?
  saleId          String?      @map("sale_id")    // Sale phụ trách
  note            String?
  isActive        Boolean      @default(true) @map("is_active")

  // Payment Terms & Credit Control
  paymentTermDays     Int      @default(0) @map("payment_term_days")     // 0=Cash, 7=Net7, 15=Net15, 30=Net30, 60=Net60
  gracePeriodDays     Int      @default(3) @map("grace_period_days")     // Extra days before marking overdue
  overdueInterestRate Decimal  @default(0) @map("overdue_interest_rate") @db.Decimal(5, 2) // Annual interest rate %
  isBlocked           Boolean  @default(false) @map("is_blocked")
  blockReason         String?  @map("block_reason")
  blockedAt           DateTime? @map("blocked_at")

  // Exchange rate mode
  exchangeRateMode    String?  @map("exchange_rate_mode") // FIXED | FLOATING

  // Grace period
  gracePeriodUntil    DateTime? @map("grace_period_until")

  // Temporary overdraft
  tempOverdraftLimit      Decimal?  @map("temp_overdraft_limit") @db.Decimal(18, 2)
  tempOverdraftExpiry     DateTime? @map("temp_overdraft_expiry")
  tempOverdraftApprovedBy String?   @map("temp_overdraft_approved_by")

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  contacts        Contact[]
  wallet          Wallet?
  orders          Order[]
  masterOrders    MasterOrder[]
  receivables     AccountReceivable[]
  quotations      Quotation[]
  complaints      Complaint[]
  contracts       Contract[]
  agingSnapshots  ARAgingSnapshot[]
  interactionNotes CustomerInteractionNote[]
  returnRequests  ReturnRequest[]
  analytics         CustomerAnalytics?
  priceOverrides    CustomerPriceOverride[]
  bankWebhooks      BankWebhookTransaction[] @relation("CustomerBankWebhooks")

  @@index([saleId])
  @@index([tier])
  @@index([saleId, isActive], map: "idx_customers_sale_active")
  @@index([tier, isActive], map: "idx_customers_tier_active")
  @@index([phone], map: "idx_customers_phone")
  @@index([isActive, createdAt], map: "idx_customers_active_created")
  @@map("customers")
}

model Contact {
  id          String   @id @default(cuid())
  customerId  String   @map("customer_id")
  fullName    String   @map("full_name")
  phone       String?
  email       String?
  position    String?
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("contacts")
}

model Wallet {
  id          String   @id @default(cuid())
  customerId  String   @unique @map("customer_id")
  balance     Decimal  @default(0) @db.Decimal(18, 2)
  currency    Currency @default(VND)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer    Customer @relation(fields: [customerId], references: [id])
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id              String   @id @default(cuid())
  walletId        String   @map("wallet_id")
  amount          Decimal  @db.Decimal(18, 2)  // + nạp, - trừ
  type            String   // TOPUP, DEDUCT, REFUND
  reference       String?  // Mã tham chiếu (orderId, paymentId)
  bankTraceId     String?  @unique @map("bank_trace_id") // Mã GD ngân hàng - chống trùng
  allocationType  String?  @map("allocation_type") // CONTRACT, ORDER, UNALLOCATED
  allocationId    String?  @map("allocation_id")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")

  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  bankWebhook     BankWebhookTransaction? @relation("WalletTxBankWebhook")

  @@index([walletId, createdAt])
  @@index([allocationType, allocationId])
  @@map("wallet_transactions")
}

// ============================================
// CUSTOMER INTERACTION NOTE — Quick paste from Zalo/WeChat (CSKH-5)
// ============================================

model CustomerInteractionNote {
  id          String   @id @default(cuid())
  customerId  String   @map("customer_id")
  content     String
  channel     String   // ZALO, WECHAT, PHONE, EMAIL, OTHER
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([createdBy])
  @@map("customer_interaction_notes")
}

// ============================================
// LEAD — Prospective customer pipeline (KD-4)
// ============================================

model Lead {
  id                  String   @id @default(cuid())
  code                String   @unique // LEAD-YYYYMM-XXXX
  fullName            String   @map("full_name")
  companyName         String?  @map("company_name")
  phone               String?
  email               String?
  source              String   // WEBSITE, REFERRAL, EXHIBITION, SOCIAL_MEDIA, COLD_CALL
  status              String   @default("NEW") // NEW, CONTACTING, QUOTED, CONVERTED, LOST
  assignedTo          String?  @map("assigned_to")
  lostReason          String?  @map("lost_reason")
  convertedCustomerId String?  @map("converted_customer_id")
  notes               LeadNote[]
  createdBy           String   @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([assignedTo])
  @@index([status])
  @@index([createdBy])
  @@index([status, assignedTo], map: "idx_leads_status_assigned")
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content   String
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId])
  @@map("lead_notes")
}
