// ─────────────────────────────────────────────────────────────
// Blog & Content Management System
// ─────────────────────────────────────────────────────────────

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

/// Blog Categories
model BlogCategory {
  id          String     @id @default(cuid())
  slug        String     @unique @db.VarChar(255)
  name        String     @db.VarChar(255)
  description String?    @db.VarChar(1000)
  coverImage  String?    @db.VarChar(500)

  // SEO
  metaTitle       String? @db.VarChar(255)
  metaDescription String? @db.VarChar(500)

  // Organization
  parentId    String?
  parent      BlogCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    BlogCategory[] @relation("CategoryHierarchy")
  order       Int            @default(0)

  // Posts
  posts       BlogPost[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
  @@map("blog_categories")
}

/// Blog posts for the CMS
model BlogPost {
  id          String          @id @default(cuid())
  slug        String          @unique @db.VarChar(255)
  title       String          @db.VarChar(500)
  excerpt     String?         @db.VarChar(1000)
  content     String          @db.Text
  coverImage  String?         @db.VarChar(500)

  // Author
  authorId    String
  author      User            @relation("BlogPostAuthor", fields: [authorId], references: [id])
  authorName  String          @db.VarChar(255)

  // Categorization
  categoryId  String?
  category    BlogCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        String[]        @default([])

  // SEO Fields
  metaTitle       String?     @db.VarChar(255)
  metaDescription String?     @db.VarChar(500)
  metaKeywords    String[]    @default([])
  ogImage         String?     @db.VarChar(500)

  // Status & Publishing
  status      BlogPostStatus  @default(DRAFT)
  isFeatured  Boolean         @default(false)
  publishedAt DateTime?
  scheduledAt DateTime?

  // Engagement
  viewCount   Int             @default(0)
  likeCount   Int             @default(0)

  // Reading time (in minutes)
  readingTime Int?

  // Related posts
  relatedPostIds String[]     @default([])

  // Relations
  comments    BlogComment[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([slug])
  @@index([tags])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([authorId])
  @@index([publishedAt])
  @@index([status])
  @@map("blog_posts")
}

/// Blog Comments (optional - if you want comments)
model BlogComment {
  id        String   @id @default(cuid())
  postId    String

  // Post relation
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Author info
  authorName  String   @db.VarChar(255)
  authorEmail String   @db.VarChar(255)
  authorUrl   String?  @db.VarChar(500)

  // Comment content
  content   String   @db.Text

  // Hierarchy (for replies)
  parentId  String?
  parent    BlogComment? @relation("CommentHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  replies   BlogComment[] @relation("CommentHierarchy")

  // Moderation
  isApproved Boolean  @default(false)
  ip        String?  @db.VarChar(50)
  userAgent String?  @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, isApproved])
  @@index([parentId])
  @@index([postId])
  @@map("blog_comments")
}
