# Application
APP_PORT=3000
APP_ENV=development
APP_NAME=TBS_ERP

# Database
# SECURITY: Use strong passwords in production, never commit real credentials
DATABASE_URL=postgresql://username:password@localhost:5432/dbname?schema=public

# JWT
# SECURITY: Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# PRODUCTION: Store in AWS Secrets Manager, Azure Key Vault, or HashiCorp Vault
# These placeholder values will NOT work - you must generate your own
JWT_SECRET=REPLACE_WITH_YOUR_GENERATED_SECRET_128_CHARS_MIN
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_YOUR_GENERATED_REFRESH_SECRET_128_CHARS_MIN
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage (S3/GCS)
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# Exchange Rate API
EXCHANGE_RATE_API_URL=https://api.vietcombank.com.vn/fx

# CORS
CORS_ORIGINS=http://localhost:3001

# Business Settings — Deposit Rates (as decimal, e.g., 1.0 = 100%)
DEPOSIT_RATE_NEW=1.0
DEPOSIT_RATE_REGULAR=0.7
DEPOSIT_RATE_VIP=0.5
DEPOSIT_RATE_STRATEGIC=0.3
DEPOSIT_AUTO_CANCEL_DAYS=3

# Business Settings — Customer Tier Thresholds
TIER_REGULAR_MIN_ORDERS=10
TIER_VIP_MIN_ORDERS=20

# Business Settings — Approval
APPROVAL_ESCALATE_HOURS=24
DISCOUNT_LEVEL2=0.03
DISCOUNT_LEVEL3=0.05
HIGH_VALUE_ORDER=100000000
