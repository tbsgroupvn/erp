# Application
APP_PORT=3000
APP_ENV=development
APP_NAME=TBS_ERP

# Branding (customize for your company)
COMPANY_NAME=My ERP
COMPANY_FULL_NAME=My ERP Company
COMPANY_DOMAIN=localhost
CUSTOMER_CODE_PREFIX=ERP-KH-
SUPPORT_EMAIL=support@localhost
SUPPORT_PHONE=
APP_TITLE=ERP System
COMPANY_ADDRESS=
COMPANY_TAX_CODE=
SEED_EMAIL_DOMAIN=example.com

# Database
# SECURITY: Use strong passwords in production, never commit real credentials
DATABASE_URL=postgresql://username:password@localhost:5432/dbname?schema=public

# For production with PgBouncer connection pooling:
# DATABASE_URL=postgresql://username:password@pgbouncer:6432/dbname?pgbouncer=true
# Direct connection for Prisma migrations (bypasses PgBouncer):
# DIRECT_DATABASE_URL=postgresql://username:password@postgres:5432/dbname

# Replication (only needed for PostgreSQL HA setup)
# REPLICATION_PASSWORD=your_strong_replication_password_here

# JWT
# SECURITY: Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# PRODUCTION: Store in AWS Secrets Manager, Azure Key Vault, or HashiCorp Vault
# These placeholder values will NOT work - you must generate your own
JWT_SECRET=REPLACE_WITH_YOUR_GENERATED_SECRET_128_CHARS_MIN
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_YOUR_GENERATED_REFRESH_SECRET_128_CHARS_MIN
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage (S3/GCS)
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# Exchange Rate API
EXCHANGE_RATE_API_URL=https://api.vietcombank.com.vn/fx

# CORS (comma-separated origins; include chrome-extension:// for browser extension)
CORS_ORIGINS=http://localhost:3001,chrome-extension://YOUR_EXTENSION_ID_HERE

# Business Settings — Deposit Rates (as decimal, e.g., 1.0 = 100%)
DEPOSIT_RATE_NEW=1.0
DEPOSIT_RATE_REGULAR=0.7
DEPOSIT_RATE_VIP=0.5
DEPOSIT_RATE_STRATEGIC=0.3
DEPOSIT_AUTO_CANCEL_DAYS=3

# Business Settings — Customer Tier Thresholds
TIER_REGULAR_MIN_ORDERS=10
TIER_VIP_MIN_ORDERS=20

# Business Settings — Approval
APPROVAL_ESCALATE_HOURS=24
DISCOUNT_LEVEL2=0.03
DISCOUNT_LEVEL3=0.05
HIGH_VALUE_ORDER=100000000

# === Business Configuration ===
# Order thresholds
# OVERDUE_THRESHOLD_DAYS=15
# MAX_ORDER_ITEMS=100

# Financial limits
# MAX_VOUCHER_AMOUNT=500000000
# MIN_REASON_LENGTH=20
# AR_DUE_DATE_DAYS=30

# Complaint compensation thresholds
# COMPENSATION_GD_KD_THRESHOLD=5000000
# COMPENSATION_BGD_THRESHOLD=20000000

# Commission
# DEFAULT_COMMISSION_RATE=0.03
# COMMISSION_AUTO_APPROVE=1000000

# Overdraft (KD-3: calculated in business hours)
# OVERDRAFT_BUSINESS_HOURS=24

# COD (TX-3: enforcement deadline calculated in business hours)
# COD_SHORTAGE_TOLERANCE=0.01
# COD_ENFORCEMENT_HOURS=24

# Debt netting (KT-2: configurable minimum threshold)
DEBT_NETTING_MIN=100000

# Customer portal - wallet limits
# WALLET_TOPUP_MIN=100000
# WALLET_TOPUP_MAX=100000000

# Payroll deductions and rates
# PERSONAL_DEDUCTION=11000000
# DEPENDENT_DEDUCTION=4400000
# INSURANCE_RATE=0.105

# Rate limiting
# LOGIN_RATE_LIMIT=5
# API_RATE_LIMIT=100

# Bank Webhook (auto-reconciliation for wallet top-ups)
BANK_WEBHOOK_SECRET=your-webhook-secret-here
BANK_WEBHOOK_ENABLED=false

# === Cache TTLs (seconds) ===
# CACHE_TTL_EXCHANGE=3600
# CACHE_TTL_DASHBOARD=300
# CACHE_TTL_COMMISSION=1800
