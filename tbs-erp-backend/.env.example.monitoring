# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/tbs_erp"

# ============================================
# JWT
# ============================================
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ============================================
# MONITORING & ERROR TRACKING
# ============================================

# Sentry DSN (Get from: https://sentry.io/)
# Sign up for free account, create project, copy DSN
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# APM (Application Performance Monitoring)
# Options: datadog, newrelic, elastic-apm
# APM_ENABLED=true
# APM_SERVICE_NAME="tbs-erp-backend"

# ============================================
# SERVER
# ============================================
NODE_ENV="production"
PORT=3001
FRONTEND_URL="https://app.tbslogistics.com"

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================
# LOG LEVEL
# ============================================
# Options: error, warn, info, debug
LOG_LEVEL="info"
