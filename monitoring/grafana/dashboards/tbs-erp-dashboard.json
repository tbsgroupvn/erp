      "type": "timeseries",
      "targets": [
        {
          "expr": "(sum(rate(http_requests_total{status_code=~\"5..\",job=\"tbs-erp-backend\"}[5m])) / sum(rate(http_requests_total{job=\"tbs-erp-backend\"}[5m]))) * 100",
          "legendFormat": "5xx Error Rate %"
        },
        {
          "expr": "(sum(rate(http_requests_total{status_code=~\"4..\",job=\"tbs-erp-backend\"}[5m])) / sum(rate(http_requests_total{job=\"tbs-erp-backend\"}[5m]))) * 100",
          "legendFormat": "4xx Error Rate %"
