  prevRate  Decimal?        @map("prev_rate") @db.Decimal(18, 2)
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade) // prod KHÔNG FK: 40 dòng mồ côi bị loại lúc nạp (migration A2, Q3) — v2 siết FK

