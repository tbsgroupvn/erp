// ═══ #08 fix-round-1 (23/09/2026) — bảng tỷ giá TREASURY dùng bởi
// `tbs_decl_usd_rate()` (libs/decl_source.php), hạng 2/3 trong thang tra
// tỷ giá của `recalcItemTax`. ⚠ KHÁC HẲN `MhRate`/`tbl_mh_tygia` phía trên
// (bảng đó phục vụ tỷ giá mua-hộ/ví, có "hiệu lực từ/đến" — hai bảng tỷ giá
// SONG SONG, không được gộp hay dùng lẫn cho nhau). Đo prod 23/09/2026:
// tbl_exchange_rates = 0 DÒNG — bảng CHƯA TỪNG được nạp dữ liệu, nên nhánh
// "0 dòng ⇒ getRate trả 0 ⇒ no_rate" là đường DUY NHẤT từng chạy thật (xem
// DeclSourceService.usdRateForFile + test/customs/usd-rate-for-file.spec.ts).
enum Currency {
  CNY
  USD
}

model ExchangeRate {
  id Int @id @default(autoincrement())

  currency Currency
  rateVnd  Decimal  @map("rate_vnd") @db.Decimal(12, 2)
  rateDate DateTime @map("rate_date") @db.Date

  createdBy String @default("") @map("created_by")
  cdate     Int    @default(0)

  // ⚠⚠ IMPORTANT 2 (fix-round-2, 23/09/2026) — coordinator đo prod:
  // `uq_cur_date` UNIQUE trên (currency, rate_date), `non_unique=0`. Bản
  // trước model plain @@index — với trùng lặp có thể xảy ra, `findFirst
  // orderBy rateDate desc` không có cách phân định (tiebreaker), khiến tỷ
  // giá chọn được NHÔNG XÁC ĐỊNH (và do đó cả tiền thuế) giữa các lần chạy.
  // @@unique tạo UNIQUE INDEX — vẫn phục vụ đúng truy vấn
  // getRate(currency,date)=SELECT...WHERE currency=? AND rate_date<=?
  // ORDER BY rate_date DESC LIMIT 1 (một UNIQUE INDEX vẫn dùng được cho
  // range scan như index thường), CỘNG THÊM chặn trùng lặp ở tầng CSDL.
  // Service vẫn giữ tiebreaker `id DESC` tường minh trong ORDER BY (xem
  // decl-source.service.ts) thay vì dựa vào constraint này — phòng khi có
  // dữ liệu cũ nạp trước khi constraint tồn tại, hoặc constraint bị gỡ sau
  // này mà code không được cập nhật theo.
  @@unique([currency, rateDate])
  @@map("tbl_exchange_rates")
}

// ═══ #04b (24/09/2026) — "trả về cho người nộp sửa" (CLS_TRAVE), Task 1.
// Chép cột-đối-cột prod (`tbl_return_config`/`tbl_return_fields`/`tbl_return_state`,
// đo `information_schema` 24/09/2026, xem docs/rewrite-spec/04b-tra-ve-nguoi-nop-sua.md §7.1/§8.2).
// Không FK từ ReturnState tới đối tượng gốc (đa hình: 'approval_request' | 'payment', như prod).
enum ReturnCheckpointType {
  approval
  biz
}

enum ReturnEditMode {
  off
  all
  whitelist
}

enum ReturnStateValue {
  returned
  resubmitted
}

model ReturnConfig {
  id             Int                  @id @default(autoincrement())
  checkpointType ReturnCheckpointType @map("checkpoint_type")
  checkpointRef  String               @map("checkpoint_ref") @db.VarChar(60) // approval: id bước dạng chuỗi; biz: khoá tv_checkpoints
  editMode       ReturnEditMode       @default(off) @map("edit_mode")
  requireReason  Boolean              @default(true) @map("require_reason")
  updatedBy      String?              @default("") @map("updated_by") @db.VarChar(50)
  updatedAt      Int?                 @default(0) @map("updated_at")
  fields         ReturnConfigField[]

  @@unique([checkpointType, checkpointRef])
  @@map("tbl_return_config")
}

model ReturnConfigField {
  id       Int          @id @default(autoincrement())
  configId Int          @map("config_id")
  fieldKey String       @map("field_key") @db.VarChar(60)
  config   ReturnConfig @relation(fields: [configId], references: [id], onDelete: Cascade) // prod không FK — mồ côi (A5) bị loại lúc nạp, hệ mới siết bằng FK

  @@unique([configId, fieldKey])
  @@map("tbl_return_fields")
}

model ReturnState {
  id             Int                  @id @default(autoincrement())
  objectType     String               @map("object_type") @db.VarChar(30) // 'approval_request' | 'payment'
  objectId       Int                  @map("object_id") // prod bigint; mọi giá trị nguồn ≤ 97.817 — Int khớp ApprovalRequest.id (Q8)
  checkpointType ReturnCheckpointType @map("checkpoint_type")
  checkpointRef  String               @map("checkpoint_ref") @db.VarChar(60)
  state          ReturnStateValue     @default(returned)
  reason         String               @default("") @db.VarChar(255)
  round          Int                  @default(1) @db.SmallInt
  fieldsOpened   Json                 @map("fields_opened") // mảng field_key, ảnh chụp lúc trả
  dataBefore     Json?                @map("data_before")
  dataAfter      Json?                @map("data_after") // '' prod -> NULL
  returnedBy     String               @map("returned_by") @db.VarChar(50)
  returnedAt     Int                  @map("returned_at")
  resubmittedAt  Int?                 @map("resubmitted_at") // 0 prod -> NULL

  @@unique([objectType, objectId])
  @@index([state])
  @@map("tbl_return_state")
}

// ===== #09a Phiếu thanh toán NCC (Supplier Payment) — ĐỢT 1: model + migration ONLY =====
// Chép cột-đối-cột prod tbl_payment/tbl_payment_orders/tbl_payment_log/tbl_payment_source
// (đo information_schema 24/09/2026, docs/rewrite-spec/09a-thanh-toan-ncc.md §2/§8).
// Task 1 của kế hoạch 09a đợt 1 — KHÔNG có service/HTTP ở đợt này (Q10 mặc định: ở lại PHP).
//
// ⚠⚠⚠ KHÔNG FK tới Order/PurchaseOrder dù hai model đó đã có trong schema này (#06).
// Prod tự thân KHÔNG FK orderId/poId (đo: 9 orderId mồ côi, order_id=0 hợp lệ cho phiếu
// gộp pay_type='supplier', po_id=0 hợp lệ khi không có PO) — port trung thành nghĩa là
// giữ nguyên KHÔNG ràng buộc, không phải "giờ có model rồi thì thêm FK cho chặt".
//
// price_cyn/price_payment: prod decimal(65,2) nhưng đo được MAX price_cyn 8,7×10⁸ và
// MAX price_payment 1,84×10⁹ — Decimal(18,2) đủ, không mất giá trị (đặc tả §8 mở đầu).
enum PaymentCurrency {
  CNY
  USD
}

model SupplierPayment {
  id    Int  @id @default(autoincrement()) // prod bigint, MAX 53.736 — Int khớp quy ước ReturnState.objectId (Q9 mặc định)
  cdate Int? // unix; 0 dòng NULL thực tế nhưng giữ nullable như kiểu cột prod (int(11) NULL)
  mdate Int? // 12.181/15.517 NULL (phiếu cũ chưa từng sửa/duyệt qua đường ghi mdate) — giữ NULL, KHÔNG suy ra từ cdate

  priceCyn Decimal?        @map("price_cyn") @db.Decimal(18, 2) // số nguyên tệ; rate_buy=1 ⇒ là VND (25 dòng, §11.2)
  currency PaymentCurrency @default(CNY) // ⚠ KHÔNG đáng tin cho phiếu cũ (276 dòng CNY có tỷ giá USD, §11.2) — đừng dùng để phân loại quỹ
  rateBuy  Int?            @map("rate_buy") // int(11) prod — process_edit_batch_rate.php ghi floatval() vào, MariaDB làm tròn

  saler String? @db.VarChar(50) // người TẠO phiếu (tên sai lệch lịch sử); KHÔNG FK — 335/15.517 dòng trỏ user đã mất khỏi tbl_user
  from  String? @db.VarChar(50) // "Đặt hàng tại": Thanh toán ngoài | 1688 | Taobao | Khác | Xiamyu

  source    String? @db.VarChar(50) // NHÃN nguồn tệ tự do lịch sử — ví thật tra qua accountCode, KHÔNG qua cột này
  codeOrder String? @map("code_order") @db.VarChar(255) // mã đơn, hoặc mã PO khi phiếu gộp — giữ NGUYÊN BYTE, đừng TRIM (2 dòng có khoảng trắng đầu/cuối)
  orderId   Int?    @map("order_id") // ⚠ 0 = phiếu gộp (pay_type='supplier') là GIÁ TRỊ THẬT, KHÔNG NULLIF; 9 dòng mồ côi giữ nguyên — không FK

  note         String?  @db.VarChar(255)
  notePayment  String?  @map("note_payment") // 2 định dạng trong 1 cột: JSON mảng tệp đính kèm | chữ thường "Danh sách đơn (N): …" — giữ TEXT, không parse
  pricePayment Decimal? @map("price_payment") @db.Decimal(18, 2) // số VND dẫn xuất; 14.328/15.517 NULL là BÌNH THƯỜNG (web tạo không ghi) — KHÔNG backfill ROUND(priceCyn*rateBuy), mã đọc tự rơi về công thức (§11.1)

  payment String? @default("no") @db.VarChar(3) // cờ "Đã TT": giữ NGUYÊN 3 giá trị NULL/'no'/'yes' — KHÔNG chuẩn hoá NULL→'no' (migration M2)
  pdate   Int? // ngày "Đã TT" — có ⇔ payment='yes' (đo 1.016/1.016, 0 ngoại lệ)

  status  String? @default("no") @db.VarChar(3) // BẢN SAO confirm (D7) — mọi ghi trong service phải đặt CẢ HAI cột cùng lúc (Q8 mặc định)
  confirm String? @default("no") @db.VarChar(3) // duy nhất do confirm() đặt 'yes' — xem 09a §3.2/§5.11

  poId    Int    @default(0) @map("po_id") // 0 = không có PO — giá trị THẬT, giữ 0 không NULL (15.046/15.517 dòng)
  payType String @default("") @map("pay_type") @db.VarChar(20) // '' = luồng cũ (15.084) | 'supplier' = gộp từ PO (433)

  billImages String? @map("bill_images") // JSON mảng URL uploads/payment/… dạng chuỗi

  accountCode String @default("") @map("account_code") @db.VarChar(10) // ⛔ ví quỹ bị trừ — '' LÀ GIÁ TRỊ THẬT (14.238/15.517 dòng không trừ quỹ nào), KHÔNG NULLIF

  nccReceiver      String  @default("") @map("ncc_receiver") @db.VarChar(150)
  nccBankName      String  @default("") @map("ncc_bank_name") @db.VarChar(150)
  nccBankAccount   String  @default("") @map("ncc_bank_account") @db.VarChar(80) // ⚠ KHÔNG in ra log ETL/ứng dụng (migration §2.1)
  nccQrImage       String  @default("") @map("ncc_qr_image") @db.VarChar(255)
  nccBankNote      String? @map("ncc_bank_note") @db.VarChar(255)
  nccPayChannel    String  @default("bank") @map("ncc_pay_channel") @db.VarChar(20) // bank | 1688 | taobao
  nccPlatformOrder String  @default("") @map("ncc_platform_order") @db.VarChar(255)

  nccInvoiceImages     String? @map("ncc_invoice_images") // giữ chuỗi JSON nguyên — mergeResubmit (04b) so ép chuỗi, Json '[]' ≠ chuỗi '[]' sinh "trường đã đổi" giả
  nccPackingListImages String? @map("ncc_packing_list_images")

  ktNote String? @map("kt_note")

  ttNgoaiKieu String @default("") @map("tt_ngoai_kieu") @db.VarChar(20) // '' | alipay | wechat | tk_canhan | tk_cty

  orders SupplierPaymentOrder[]

  @@index([poId])
  @@index([accountCode])
  @@index([orderId])
  @@map("tbl_payment")
}

