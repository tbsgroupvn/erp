// 09b đợt 1 — Sổ quỹ / Ví quỹ công ty (CLS_TREASURY). Đặc tả:
// docs/rewrite-spec/09b-so-quy-treasury.md §9; migration:
// docs/rewrite-spec/migration/09b-so-quy-treasury.md. Model-only ở đợt này —
// TreasuryService/GL-biết-ví/đọc HTTP là Task 2-3 (không có ở nhánh này).
enum FundCurrency {
  VND
  CNY
  USD
}

enum FundGroup {
  bank
  store
}

model FundAccount {
  // tbl_accounts — 15 dòng prod, id 1-321. KHÔNG mang cột `password` (§2.1 Q15:
  // không mã nào đọc; mật khẩu API cũ nằm ở gfconfig.php, không migrate).
  id             Int          @id @default(autoincrement())
  code           String       @unique @db.VarChar(10)
  name           String       @db.VarChar(100)
  subname        String       @default("") @db.VarChar(150)
  currency       FundCurrency @default(VND)
  accGroup       FundGroup    @default(bank) @map("acc_group")
  hasGout        Int          @default(0) @map("has_gout") @db.SmallInt
  displayOrder   Int          @default(0) @map("display_order")
  isActive       Int          @default(1) @map("is_active") @db.SmallInt
  note           String       @default("") @db.VarChar(255)
  // `0` là THẬT (10/15 ví opening=0) — KHÔNG NULLIF.
  openingBalance Decimal      @default(0) @map("opening_balance") @db.Decimal(20, 5)
  // Khoá ánh xạ SePay (`findBySTK`) — KHÔNG log giá trị cột này ra ngoài (đặc tả §2.1/§6).
  stk            String       @default("") @db.VarChar(30)
  bankCode       String       @default("") @map("bank_code") @db.VarChar(30)
  walletStream   String       @default("cty") @map("wallet_stream") @db.VarChar(10)
  customLabel    String       @default("") @map("custom_label") @db.VarChar(50)
  cdate          Int          @default(0)
  mdate          Int          @default(0)
  ownerUid       Int?         @default(0) @map("owner_uid")
  // '' = chưa khai vế tiền GL (TK07) — postBiz GIỮ cặp mapping cũ khi rỗng; KHÔNG NULLIF.
  glAccount      String       @default("") @map("gl_account") @db.VarChar(20)
  quyDoiSang     String       @default("") @map("quy_doi_sang") @db.VarChar(10)

  @@map("tbl_accounts")
}

model TreasuryEntry {
  // tbl_account_histories — 2.429 dòng prod, id 1.788.363.983-1.790.251.005
  // (< 2³¹-1 ⇒ Int, đặc tả §9/Q2). `id` nạp TƯỜNG MINH lúc ETL, sequence chỉ
  // cấp id MỚI sau `setval` (migration §6) — v2 KHÔNG cấp id theo time() như prod.
  id             Int      @id @default(autoincrement())
  // KHÔNG FK tới FundAccount.code: 39 dòng 'CHI-TBS'/'THU-TBS'/'THEO-DOI-CN'
  // là mã theo dõi, cố ý không có trong danh mục ví (đặc tả §2.2/§12.5).
  tkCode         String?  @map("tk_code") @db.VarChar(50)
  // 'in' | 'out' | 'tranfer' (sic, giữ nguyên chính tả — KHOÁ lọc báo cáo,
  // đặc tả §12.1) | 'note' (0 dòng hiện tại nhưng có trong mã nguồn).
  type           String?  @db.VarChar(50)
  bankInfo       String?  @map("bank_info") @db.VarChar(50)
  // NULL ≠ '' — giữ phân biệt (412 NULL, 2.017 '').
  gout           String?  @db.VarChar(255)
  walletDetailId Int?     @map("wallet_detail_id")
  // NULL ≠ '' — giữ phân biệt (2.014 NULL, 256 ''); KHÔNG FK, KHÔNG TRIM
  // (54 giá trị chữ tự do từ form phiếu, đặc tả §2.2).
  cusId          String?  @map("cus_id") @db.VarChar(50)
  cdate          Int?
  cuser          String?  @db.VarChar(50)
  // Có dấu, đơn vị = tệ của ví (không phải VND); \|max\| đo được 2,9×10¹¹, 5 chữ
  // số lẻ (đặc tả §2.2/§3.1) ⇒ giữ Decimal(20,5) như prod.
  money          Decimal? @db.Decimal(20, 5)
  // prod decimal(12,2) cắt tỷ giá FX 6 chữ số (18 dòng lệch tbl_fx_transfers.rate,
  // đặc tả P9) ⇒ NỚI Decimal(18,6) theo đề xuất §9/Q8, chốt M3 migration doc
  // ("Nới — mất độ chính xác không phải hành vi đáng chép"). NULL ≠ 0 (39 dòng
  // INSERT cũ không có cột) — giữ phân biệt.
  rate           Decimal? @db.Decimal(18, 6)
  approveUser    String?  @map("approve_user") @db.VarChar(50)
  approveDate    Int?     @map("approve_date")
  note           String?  @db.VarChar(255)
  // 1 = đã lên sổ (vào số dư) · 0 = treo/nháp (chưa gắn ví hợp lệ) · 9 = huỷ,
  // chưa từng lên số dư (đặc tả §3.2). CẢ HAI 0/9 vẫn CHẶN hasPosted — KHÔNG
  // lọc theo status khi kiểm tra đã ghi (đặc tả §12.2).
  status         Int?     @default(0) @db.SmallInt
  tranId         BigInt?  @map("tran_id")
  trandetailId   BigInt?  @map("trandetail_id")
  // '' là THẬT (39 dòng mở sổ tay/luồng bank cũ) — KHÔNG NULLIF.
  sourceModule   String   @default("") @map("source_module") @db.VarChar(20)
  sourceId       Int      @default(0) @map("source_id")
  // 0 = sentinel "không phải dòng đảo" (2.409/2.429) — logic `NOT EXISTS
  // reversal_of=h.id` của hasPosted dựa vào giá trị 0 này (đặc tả T3/§12.2).
  reversalOf     Int      @default(0) @map("reversal_of")
  reversalCode   String   @default("") @map("reversal_code") @db.VarChar(20)
  reversalReason String   @default("") @map("reversal_reason") @db.VarChar(255)
  refRequestId   Int      @default(0) @map("ref_request_id")
  poId           Int      @default(0) @map("po_id")
  containerId    Int      @default(0) @map("container_id")
  orderCode      String   @default("") @map("order_code") @db.VarChar(50)

  // KHÔNG unique — chống trùng ở tầng CODE (advisory lock, đặc tả Q3/§10.2),
  // giữ đúng thiết kế prod "đảo xong thì ghi lại được" (`ix_source` non-unique).
  @@index([sourceModule, sourceId], map: "ix_source")
  @@index([tkCode, status])
  @@index([reversalOf])
  @@index([refRequestId])
  @@index([tranId])
  @@index([walletDetailId])
  @@index([cusId])
  @@index([poId])
  @@index([containerId])
  @@index([orderCode])
  @@map("tbl_account_histories")
}

// ===== #09c L1 — FX transfer + bank cash book (model-only, không service/HTTP/ETL) =====
// Đặc tả: docs/rewrite-spec/09c-fx-ngan-hang.md §2, §9, §12; migration/09c-fx-ngan-hang.md §2.
// Plan:   docs/rewrite-spec/plans/2026-09-25-09c-L1-models-plan.md.
// Q-BANK-1/2 (đo prod 24/09): prod KHÔNG có UNIQUE một phần cho `bankid<>''` hay cho khớp chi
// đang hiệu lực ⇒ lô này CHÉP PROD — index THƯỜNG (không UNIQUE), không thêm raw SQL partial
// unique mà §9 đề xuất. Nâng lên UNIQUE là thay đổi tuỳ chọn sau (chốt trong plan header).

model FxTransfer {
  // tbl_fx_transfers — 89 dòng prod, id 16–6.797, AUTO_INCREMENT 7.090 (bộ test tạo-xoá).
  id                Int      @id @default(autoincrement())
  // FX-YYMM-NNN — sinh theo MAX tiền tố tháng (process_fx_transfer.php:140-145), không
  // sequence — có cửa sổ đua, UNIQUE chặn (§2.1).
  code              String   @unique @db.VarChar(20)
  fromTk            String   @map("from_tk") @db.VarChar(10)
  toTk              String   @map("to_tk") @db.VarChar(10)
  fromCurrency      String   @default("VND") @map("from_currency") @db.VarChar(5)
  toCurrency        String   @default("VND") @map("to_currency") @db.VarChar(5)
  amountOut         Decimal  @default(0) @map("amount_out") @db.Decimal(18, 5)
  amountIn          Decimal  @default(0) @map("amount_in") @db.Decimal(18, 5)
  rate              Decimal  @default(1) @db.Decimal(15, 6)
  // 89/89 = 0 hiện tại (getRate() đọc bảng tỷ giá rỗng) — giữ 0, KHÔNG NULLIF.
  rateSystem        Decimal  @default(0) @map("rate_system") @db.Decimal(15, 6)
  fee               Decimal  @default(0) @db.Decimal(15, 2)
  // NULL hợp lệ (0 dòng hiện tại nhưng cột cho NULL theo §9) — KHÔNG NULLIF thành ''.
  feeCurrency       String?  @map("fee_currency") @db.VarChar(10)
  // NULL = phí nhập tay (61 dòng) ≠ 0 (28 dòng có giá trị, kể cả 0,000 thật) — KHÔNG NULLIF.
  feePercent        Decimal? @map("fee_percent") @db.Decimal(6, 3)
  poId              Int      @default(0) @map("po_id")
  // NULL ≠ '' (8 dòng '' hiện tại) — giữ phân biệt.
  note              String?  @db.Text
  status            String   @default("draft") @db.VarChar(20)
  // 4 dòng trỏ phiếu duyệt đã xoá cứng (#246–#249) — KHÔNG FK.
  approvalRequestId Int      @default(0) @map("approval_request_id")
  createdBy         String   @default("") @map("created_by") @db.VarChar(50)
  createdAt         Int      @default(0) @map("created_at")
  // = người NỘP, không phải người duyệt (bẫy §12.3, fxTransferDuyetXong ghi submitted_by).
  approvedBy        String   @default("") @map("approved_by") @db.VarChar(50)
  approvedAt        Int      @default(0) @map("approved_at")
  reversedBy        String   @default("") @map("reversed_by") @db.VarChar(50)
  reversedAt        Int      @default(0) @map("reversed_at")
  reverseOf         Int      @default(0) @map("reverse_of")
  // 0 = sentinel "chưa neo" (81/89) — 8 dòng >0 neo 1:1 với BankTransaction.id, KHÔNG FK.
  bankTranId        BigInt   @default(0) @map("bank_tran_id")
  agentRate         Decimal  @default(0) @map("agent_rate") @db.Decimal(18, 6)
  agentTk           String   @default("") @map("agent_tk") @db.VarChar(10)
  agentAmount       Decimal  @default(0) @map("agent_amount") @db.Decimal(18, 5)

  @@index([approvalRequestId], map: "idx_approval")
  @@index([createdAt], map: "idx_fx_created")
  @@index([fromTk], map: "idx_from_tk")
  @@index([toTk], map: "idx_to_tk")
  @@index([status], map: "idx_status")
  @@map("tbl_fx_transfers")
}

model FxAdjustment {
  // tbl_fx_adjustments — 0 dòng prod hiện tại (bảng bật cho_am khi duyệt lại — nếu có dòng
  // lúc rút ETL thì DỪNG, đo lại theo migration §2.2). Chỉ tạo bảng ở lô này.
  id        Int     @id @default(autoincrement())
  fxId      Int     @map("fx_id")
  requestId Int     @default(0) @map("request_id")
  oldRate   Decimal @default(0) @map("old_rate") @db.Decimal(18, 6)
  oldOut    Decimal @default(0) @map("old_out") @db.Decimal(20, 5)
  oldIn     Decimal @default(0) @map("old_in") @db.Decimal(20, 5)
  oldFee    Decimal @default(0) @map("old_fee") @db.Decimal(20, 2)
  oldFeeCur String? @map("old_fee_cur") @db.VarChar(3)
  newRate   Decimal @default(0) @map("new_rate") @db.Decimal(18, 6)
  newOut    Decimal @default(0) @map("new_out") @db.Decimal(20, 5)
  newIn     Decimal @default(0) @map("new_in") @db.Decimal(20, 5)
  newFee    Decimal @default(0) @map("new_fee") @db.Decimal(20, 2)
  newFeeCur String? @map("new_fee_cur") @db.VarChar(3)
  deltaOut  Decimal @default(0) @map("delta_out") @db.Decimal(20, 5)
  deltaIn   Decimal @default(0) @map("delta_in") @db.Decimal(20, 5)
  deltaFee  Decimal @default(0) @map("delta_fee") @db.Decimal(20, 2)
  // JSON mảng id dòng sổ — giữ chuỗi nguyên văn, không parse ở tầng model.
  histIds   String? @map("hist_ids") @db.VarChar(255)
  reason    String  @db.VarChar(255)
  cuser     String  @db.VarChar(50)
  cdate     Int

  @@index([fxId], map: "idx_fx")
  @@index([requestId], map: "idx_req")
  @@map("tbl_fx_adjustments")
}

model FxFeeRate {
  // tbl_fx_fee_rates — 6 dòng prod, id 1–6, AI 27, UNIQUE uq_pair(from_cur,to_cur) — prod CÓ.
  id         Int     @id @default(autoincrement())
  fromCur    String  @map("from_cur") @db.VarChar(3)
  toCur      String  @map("to_cur") @db.VarChar(3)
  feePercent Decimal @default(0) @map("fee_percent") @db.Decimal(6, 3)
  updatedBy  String? @map("updated_by") @db.VarChar(50)
  updatedAt  Int?    @map("updated_at")

  @@unique([fromCur, toCur], map: "uq_pair")
  @@map("tbl_fx_fee_rates")
}

model FundAccountChangelog {
  // tbl_account_changelog — 22 dòng prod, id 7–28, AI 29.
  id          Int     @id @default(autoincrement())
  accountId   Int     @default(0) @map("account_id")
  accountCode String  @default("") @map("account_code") @db.VarChar(10)
  action      String  @default("") @db.VarChar(30)
  // JSON nguyên văn; 4/22 dòng chứa STK ngân hàng dạng rõ (khoá JSON `stk`) — KHÔNG log/in
  // giá trị cột này ở bất kỳ đâu (đặc tả §12.13).
  changes     String? @db.Text
  // 0 = ghi trước khi có id người dùng trong phiên (5 dòng) — giữ 0, KHÔNG NULLIF.
  userId      Int     @default(0) @map("user_id")
  userName    String  @default("") @map("user_name") @db.VarChar(80)
  createdAt   Int     @default(0) @map("created_at")

  @@index([accountCode], map: "idx_account")
  @@index([createdAt], map: "idx_changelog_created")
  @@map("tbl_account_changelog")
}

model BankTransaction {
  // tbl_bank_transaction — 17.123 dòng prod, id 193–17.323, AI 17.324. utf8mb3_general_ci
  // (cus_id utf8mb3_unicode_ci) — không ảnh hưởng Postgres. KHÔNG index/UNIQUE trên `bankid`
  // ở prod (khoá chống trùng webhook, P-B4) và không index `tk_code` — chép nguyên trạng.
  id          BigInt  @id @default(autoincrement())
  // '' = không phải SePay (2.619/17.123 dòng nhập tay/SMS/cũ) — ⛔ '' THẬT, KHÔNG NULLIF.
  bankid      String  @db.VarChar(10)
  bankName    String? @map("bank_name") @db.VarChar(50)
  // KHÔNG log — số tài khoản ngân hàng (đặc tả §12.13).
  bankAccount String? @map("bank_account") @db.VarChar(20)
  tranType    String? @map("tran_type") @db.VarChar(1)
  // nguyên đồng — BigInt, KHÔNG Decimal (đặc tả §12.7).
  tranAmount  BigInt? @map("tran_amount")
  // mili-giây (strtotime(...).'000') — KHÔNG giây (đặc tả §12.8).
  tranTime    BigInt? @map("tran_time")
  tranMess    String? @map("tran_mess") @db.Text
  originMess  String? @map("origin_mess") @db.Text
  // NULL (321) ≠ '' (895) — giữ phân biệt, KHÔNG TRIM (0 khoảng trắng thừa đo được).
  cusId       String? @map("cus_id") @db.VarChar(50)
  // chuỗi '1'..'5' — giữ chuỗi, KHÔNG enum/Int (đặc tả §12.9).
  type        String? @default("1") @db.VarChar(3)
  cdate       Int?
  // NULL 292/17.123 — giữ NULL.
  mdate       Int?
  status      String? @default("no") @db.VarChar(3)
  confirm     String? @default("no") @db.VarChar(3)
  // '' = trước cutover 02/09 22:46 (16.117/17.123) — ⛔ '' THẬT, KHÔNG FK.
  tkCode      String  @default("") @map("tk_code") @db.VarChar(10)

  @@index([confirm], map: "idx_confirm")
  @@index([cusId], map: "idx_cus_id")
  // MỚI — prod không có (Q-BANK-1). Plan chốt: index THƯỜNG chép prod, không UNIQUE một phần.
  @@index([bankid])
  @@index([tkCode, tranType])
  @@map("tbl_bank_transaction")
}

model BankTransactionDetail {
  // tbl_bank_transaction_detail — 16.943 dòng prod, id 38–17.128, AI 17.129. Prod chỉ có
  // PRIMARY(id) — không index `tranId` dù mọi truy vấn lọc theo nó; v2 thêm index MỚI.
  id           BigInt  @id @default(autoincrement())
  // → BankTransaction.id (0 mồ côi đo được) — KHÔNG FK cứng, chép prod.
  tranId       BigInt? @map("tran_id")
  type         String? @db.VarChar(3)
  // nguyên đồng — BigInt (đặc tả §12.7).
  money        BigInt?
  // NULL 935/16.943 — giữ NULL, KHÔNG COALESCE.
  cusId        String? @map("cus_id") @db.VarChar(50)
  payInfo      String? @map("pay_info") @db.VarChar(100)
  note         String? @db.VarChar(255)
  // 'auto' = webhook tự phân loại (29 dòng).
  author       String? @db.VarChar(50)
  cdate        Int?
  // NULL 10/16.943 — giữ NULL.
  mdate        Int?
  confirm      String? @default("no") @db.VarChar(3)
  poId         Int     @default(0) @map("po_id")
  // NULL = dòng cũ (16.649, duyệt suy theo TK + mốc) ≠ 'cty' (243) — ⛔ KHÔNG COALESCE.
  walletStream String? @map("wallet_stream") @db.VarChar(10)

  // MỚI — prod chỉ có PK.
  @@index([tranId])
  @@map("tbl_bank_transaction_detail")
}

enum BankChiMatchMethod {
  auto
  manual
}

model BankChiMatch {
  // tbl_bank_chi_match — 77 dòng prod, id 3–79, AI 80.
  id          Int                @id @default(autoincrement())
  bankTxId    BigInt             @map("bank_tx_id")
  requestId   Int                @map("request_id")
  method      BankChiMatchMethod @default(manual)
  matchedBy   String             @map("matched_by") @db.VarChar(50)
  matchedAt   Int                @map("matched_at")
  // NULL = đang hiệu lực (77/77 hiện tại — prod chưa có đường gỡ khớp) — giữ NULL.
  unmatchedAt Int?               @map("unmatched_at")
  unmatchedBy String?            @map("unmatched_by") @db.VarChar(50)
  note        String             @default("") @db.VarChar(255)

  // Chép prod nguyên trạng: UNIQUE(bank_tx_id, unmatched_at) — NULL không chặn hai dòng
  // đang hiệu lực (P-B5, đã ghi nhận là bất thường tiềm ẩn, KHÔNG sửa ở lô này). Q-BANK-2:
  // KHÔNG thêm raw SQL UNIQUE một phần `WHERE unmatched_at IS NULL` — prod không có.
  @@unique([bankTxId, unmatchedAt], map: "uq_banktx_active")
  @@index([requestId], map: "idx_request")
  @@map("tbl_bank_chi_match")
}

model BankReconcileLink {
  // tbl_bank_reconcile_link — 125 dòng prod, id 2–126, AI 127.
  id         Int    @id @default(autoincrement())
  bankTranId BigInt @unique(map: "uq_bank") @map("bank_tran_id")
  docModule  String @default("") @map("doc_module") @db.VarChar(20)
  docId      Int    @default(0) @map("doc_id")
  matchType  String @default("manual") @map("match_type") @db.VarChar(10)
  note       String @default("") @db.VarChar(255)
  cuser      String @default("") @db.VarChar(50)
  cdate      Int    @default(0)

  @@index([docModule, docId], map: "idx_doc")
  @@map("tbl_bank_reconcile_link")
}
