generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wallet {
  id     BigInt @id @default(autoincrement())
  cusId  String @unique @map("cus_id")
  total  BigInt @default(0)
  status Int    @default(1)

  @@map("tbl_wallet")
}

model WalletEntry {
  id          BigInt  @id @default(autoincrement())
  type        Int
  accountType String  @default("cty") @map("account_type")
  cusId       String  @map("cus_id")
  oid         Int?
  money       BigInt
  payInfo     String? @map("pay_info")
  payFrom     String? @map("pay_from")
  note        String?
  cdate       Int
  author      String?
  status      Int     @default(1)
  poId        Int?    @map("po_id")
  settled     Int     @default(0)

  // ⚠⚠ NEO CHỐNG GHI TRÙNG (23/09/2026). Khoá nghiệp vụ DUY NHẤT của bút toán,
  // do bên gọi đặt (vd 'approval:123' cho phiếu duyệt #123). NULL = không neo
  // (đường ghi tay, giữ nguyên hành vi cũ — Postgres cho phép nhiều NULL trong
  // UNIQUE). Có neo thì applyEntry trở nên AN TOÀN KHI CHẠY LẠI: lần hai không
  // ghi nữa mà trả về chính bút toán đã ghi.
  // Vì sao cần: business-sync đánh dấu `synced` TRƯỚC khi handler chạy, nên nếu
  // tiến trình chết giữa chừng thì phiếu mang tiếng đã đồng bộ mà tiền chưa đi —
  // và không có cách nào chạy lại an toàn vì sổ không phân biệt được "chưa ghi"
  // với "đã ghi rồi". Neo này gỡ đúng nút đó.
  refKey String? @unique @map("ref_key")

  // Q8 (24/09/2026) — liên kết bút toán ví ↔ giao dịch ngân hàng, chở nguyên từ prod
  // (`tranId`/`trandetailId`, đo TỪNG cột: bigint(20) NULL cả hai; 15.755 dòng có giá trị).
  // Là khoá DUY NHẤT để phát hiện một giao dịch ngân hàng bị cộng vào ví quá số tiền về.
  // ⚠ 3.299 dòng cũ có trandetailId = tranId — nạp nguyên giá trị, đừng "sửa".
  tranId       BigInt? @map("tran_id")
  trandetailId BigInt? @map("trandetail_id")

  @@index([cusId])
  @@map("tbl_wallet_detail")
}

model GlAccount {
  code           String  @id
  name           String
  parentCode     String? @map("parent_code")
  nature         String
  isLeaf         Boolean @default(true) @map("is_leaf")
  active         Boolean @default(true)
  requirePartner Boolean @default(false) @map("require_partner")

  @@map("tbl_gl_account")
}

model GlEntry {
  id             Int      @id @default(autoincrement())
  entryNo        String   @unique @map("entry_no")
  entryDate      Int      @map("entry_date")
  sourceType     String   @map("source_type")
  sourceId       BigInt   @map("source_id")
  description    String?
  totalDebit     Decimal  @map("total_debit") @db.Decimal(20, 2)
  totalCredit    Decimal  @map("total_credit") @db.Decimal(20, 2)
  status         Int      @default(1)
  reversalOf     Int?     @map("reversal_of")
  reversalReason String?  @map("reversal_reason")
  createdBy      String?  @map("created_by")
  cdate          Int
  lines          GlLine[]

  @@unique([sourceType, sourceId])
  @@map("tbl_gl_entry")
}

model GlLine {
  id          Int     @id @default(autoincrement())
  entryId     Int     @map("entry_id")
  lineNo      Int     @map("line_no")
  accountCode String  @map("account_code")
  debit       Decimal @db.Decimal(20, 2)
  credit      Decimal @db.Decimal(20, 2)
  currency    String  @default("VND")
  amountCcy   Decimal @default(0) @map("amount_ccy") @db.Decimal(20, 4)
  fxRate      Decimal @default(0) @map("fx_rate") @db.Decimal(14, 4)
  cusId       String? @map("cus_id")
  orderId     Int?    @map("order_id")
  note        String?
  entry       GlEntry @relation(fields: [entryId], references: [id])

  @@map("tbl_gl_line")
}

model GlMapping {
  id            Int     @id @default(autoincrement())
  bizType       String  @unique @map("biz_type")
  bizLabel      String  @map("biz_label")
  debitAccount  String  @map("debit_account")
  creditAccount String  @map("credit_account")
  moneySide     String  @default("") @map("money_side")
  isApproved    Boolean @default(false) @map("is_approved")
  active        Boolean @default(true)

  @@map("tbl_gl_mapping")
}

// NOTE: at most ONE open row (hieu_luc_den IS NULL) per (loai, hang_khach) is enforced
// by a partial unique index that Prisma cannot express in this schema:
//   CREATE UNIQUE INDEX "tbl_mh_tygia_single_open" ON "tbl_mh_tygia" ("loai", "hang_khach")
//     WHERE "hieu_luc_den" IS NULL;
// See migration prisma/migrations/20260922074655_fx_single_open_row/migration.sql.
// Do NOT drop this on a future `db pull` / schema regen without re-adding the migration.
model MhRate {
  id         Int     @id @default(autoincrement())
  loai       String
  hangKhach  String  @default("MAC_DINH") @map("hang_khach")
  tyGia      Decimal @map("ty_gia") @db.Decimal(18, 4)
  hieuLucTu  Int     @map("hieu_luc_tu")
  hieuLucDen Int?    @map("hieu_luc_den")
  nguoiTao   String? @map("nguoi_tao")
  createdAt  Int     @map("created_at")

  @@map("tbl_mh_tygia")
}

model PoReceipt {
  id             Int     @id @default(autoincrement())
  poId           Int?    @map("po_id")
  customerId     String  @map("customer_id")
  amount         Decimal @db.Decimal(18, 2)
  // ⚠⚠ method/status/customerId/amount/allocRequestId là ĐƯỜNG SỐNG của #03
  // HoldService (src/money/hold.service.ts) — nó đọc thẳng { method:'wallet',
  // status:'no' } + loại trừ allocRequestId để tính tiền đang GIỮ. TUYỆT ĐỐI
  // không đổi tên/kiểu/bỏ 5 cột này khi mở rộng bảng cho #06 PO.
  method         String
  status         String
  allocRequestId Int?    @map("alloc_request_id")

  // ===== #06 PO — mở rộng theo đợt (dot), giữ nguyên ngữ nghĩa hold #03 =====
  receiptCode String?   @map("receipt_code")
  orderId     Int?      @map("order_id")
  bankRef     String?   @map("bank_ref")
  // ⚠ F3 (review cuối #06): prod `receipt_date` là DATE, không phải epoch —
  // và có dữ liệu trên TẤT CẢ 226 phiếu thu đo được (không phải cột "chỉ mô
  // tả" như migration doc từng ghi nhầm). DateTime? @db.Date, KHÔNG Int.
  receiptDate DateTime? @map("receipt_date") @db.Date
  dot         Int?
  approvedBy  String?   @map("approved_by")
  approvedAt  Int?      @map("approved_at")
  createdBy   String?   @map("created_by")
  cdate       Int?
  // F2 (review cuối #06) — varchar(500), có dữ liệu trên 225/226 phiếu thu đo
  // được 23/09/2026. Không có home trong bản port ban đầu; thêm lại để không
  // mất ghi chú phiếu thu ở cutover.
  note        String?   @db.VarChar(500)

  @@map("tbl_po_receipts")
}

// ===== IAM (identity & permissions) =====

enum Scope {
  own
  team
  dept
  dept_tree
  warehouse
  all
}

enum PermKind {
  allow
  deny
}

enum ScopeKind {
  warehouse
  dept
}

// Nhóm quyền CŨ (prod `tbl_user_group`, 31 dòng) — entity `LegacyGroup` theo 01-iam.md, GIỮ TỐI THIỂU:
// chỉ các cột mã mới đang đọc. `id` = gid cũ (giữ nguyên số prod, KHÔNG tự tăng).
// Hiện dùng DUY NHẤT cho miễn trừ chặn-tự-duyệt của prod approve(): nhóm `isaccountant=1 AND isactive=1`
// (prod 24/09/2026: chỉ gid 46). 01-iam.md muốn thay cờ này bằng quyền có tên — xem báo cáo I2.
model LegacyGroup {
  id           Int     @id
  name         String  @db.VarChar(50)
  isAccountant Boolean @default(false) @map("isaccountant")
  isActive     Boolean @default(true) @map("isactive")

  @@map("tbl_user_group")
}

model User {
  id           Int       @id @default(autoincrement())
  // UNIQUE phân biệt hoa-thường ở đây; UNIQUE KHÔNG phân biệt hoa-thường (như prod utf8mb3_unicode_ci)
  // là chỉ mục biểu thức `tbl_user_username_lower_key` ON lower(username) — Prisma không khai được
  // chỉ mục biểu thức, nó nằm ở migration 20260925000000_iam_unique_d8 (D8). ĐỪNG để migrate diff xoá.
  username     String    @unique
  password     String
  firstname    String?
  lastname     String?
  email        String?
  gid          Int?
  phongbanId   Int?      @map("phongban_id")
  leaderId     Int?      @map("leader_id")
  jobTitleId   Int?      @map("job_title_id")
  isSuperAdmin Boolean   @default(false) @map("is_super_admin")
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("lastlogin")
  gsecret      String?

  @@index([phongbanId])
  @@map("tbl_user")
}

model Permission {
  code   String  @id
  module String
  action String
  nhanVn String? @map("nhan_vn")
  moTa   String? @map("mo_ta")
  sort   Int     @default(0)

  @@index([module])
  @@map("tbl_perm")
}

model Role {
  id        Int              @id @default(autoincrement())
  code      String           @unique
  ten       String
  moTa      String?          @map("mo_ta")
  isSystem  Boolean          @default(false) @map("is_system")
  active    Boolean          @default(true)
  cdate     Int?
  rolePerms RolePermission[]
  userRoles UserRole[]

  @@map("tbl_role")
}

model RolePermission {
  id       Int    @id @default(autoincrement())
  roleId   Int    @map("role_id")
  permCode String @map("perm_code")
  scope    Scope
  role     Role   @relation(fields: [roleId], references: [id])

  @@unique([roleId, permCode])
  @@index([permCode])
  @@map("tbl_role_perm")
}

model UserRole {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  roleId     Int       @map("role_id")
  hieuLucTu  DateTime  @map("hieu_luc_tu") @db.Date
  hieuLucDen DateTime? @map("hieu_luc_den") @db.Date
  capBoi     String?   @map("cap_boi")
  cdate      Int?
  role       Role      @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, hieuLucTu], map: "uq_user_role") // prod uq_user_role (D8)
  @@index([userId])
  @@map("tbl_user_role")
}

model UserPermission {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  permCode String   @map("perm_code")
  loai     PermKind
  scope    Scope
  lyDo     String?  @map("ly_do")
  capBoi   String?  @map("cap_boi")
  cdate    Int?

  @@unique([userId, permCode, loai], map: "uq_user_perm") // prod uq_user_perm (D8)
  @@index([userId])
  @@map("tbl_user_perm")
}

model UserScope {
  id     Int       @id @default(autoincrement())
  userId Int       @map("user_id")
  loai   ScopeKind
  giaTri String    @map("gia_tri")

  @@unique([userId, loai, giaTri], map: "uq_user_scope") // prod uq_user_scope (D8)
  @@index([userId])
  @@map("tbl_user_scope")
}

model Department {
  id             Int     @id @default(autoincrement())
  parentId       Int?    @map("parent_id")
  duongDan       String? @map("duong_dan")
  ma             String?
  ten            String
  truongPhongUid Int?    @map("truong_phong_uid")
  sort           Int     @default(0)
  isActive       Boolean @default(true) @map("isactive")
  cdate          Int?

  @@index([parentId])
  @@index([duongDan])
  @@map("tbl_phongban")
}

model JobTitle {
  id       Int     @id @default(autoincrement())
  name     String
  level    Int
  isActive Boolean @default(true) @map("isactive")

  @@map("tbl_job_titles")
}

model Team {
  id       Int    @id @default(autoincrement())
  name     String @unique
  leaderId Int?   @map("leader_id")
  deputyId Int?   @map("deputy_id")

  @@map("tbl_team")
}

model SalerTeam {
  id       Int    @id @default(autoincrement())
  saler    String @unique
  teamName String @map("team_name")
  teamId   Int?   @map("team_id")

  @@map("tbl_saler_team")
}

model PermConfig {
  ten    String @id
  giaTri String @map("gia_tri")

  @@map("tbl_perm_cfg")
}

model LoginLog {
  id        BigInt  @id @default(autoincrement())
  userId    Int?    @map("user_id")
  username  String
  loai      String
  ip        String?
  userAgent String? @map("user_agent")
  referer   String?
  cdate     Int

  @@index([username])
  @@map("tbl_login_log")
}

model StaffLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  hanhDong  String   @map("hanh_dong")
  truocJson String?  @map("truoc_json")
  sauJson   String?  @map("sau_json")
  boi       Int?
  luc       DateTime @default(now())
  lydo      String?

  @@index([userId])
  @@map("tbl_staff_log")
}

// ===== Approval (Duyệt) =====

enum ApprovalNodeType {
  AND
  OR
  SEQ
}

enum ApprovalMode {
  manual
  auto_approve
  auto_reject
}

enum EmptyApproverAction {
  auto_approve
  to_user
  to_admin
}

enum SelfApprovalAction {
  self
  skip
  to_user
}

enum ApproverType {
  group
  user
  submitter_manager
  requester
  self_select
  step_approver
}

enum DedupMode {
  auto_all
  auto_consecutive
  none
}

enum ActionType {
  approve
  reject
  transfer
  return
  add_approver
  remove_approver
  auto_approve
  auto_reject
  revoke
  return_submitter
  resubmit
  // D4 — phần còn thiếu so với miền enum prod tbl_approval_actions.action (24/09/2026).
  // stuck_no_approver có dữ liệu thật (8 dòng); modify_* / fx_adjust là giá trị prod cho phép ghi.
  modify_submit
  modify_approve
  modify_reject
  stuck_no_approver
  fx_adjust
}

enum RequestApproverChange {
  transfer_in
  added
  excluded
}

model ApprovalTemplate {
  id                  Int            @id @default(autoincrement())
  code                String         @unique
  name                String
  objectType          String         @map("object_type")
  category            String?
  isactive            Boolean        @default(true)
  approverDedupMode   DedupMode      @default(auto_all) @map("approver_dedup_mode")
  allowRevokePending  Boolean        @default(false) @map("allow_revoke_pending")
  allowBatch          Boolean        @default(false) @map("allow_batch")
  prohibitAdminManage Boolean        @default(false) @map("prohibit_admin_manage")
  createdBy           String?        @map("created_by")
  cdate               Int?
  steps               ApprovalStep[]

  @@index([objectType])
  @@map("tbl_approval_templates")
}

model ApprovalStep {
  id                  Int                    @id @default(autoincrement())
  templateId          Int                    @map("template_id")
  stepOrder           Int                    @map("step_order")
  stepName            String?                @map("step_name")
  nodeType            ApprovalNodeType       @default(OR) @map("node_type")
  branchId            Int?                   @map("branch_id")
  approvalMode        ApprovalMode           @default(manual) @map("approval_mode")
  requireComment      Boolean                @default(false) @map("require_comment")
  allowTransfer       Boolean                @default(true) @map("allow_transfer")
  allowReturn         Boolean                @default(true) @map("allow_return")
  emptyApproverAction EmptyApproverAction    @default(to_admin) @map("empty_approver_action")
  emptyApproverRef    Int?                   @map("empty_approver_ref")
  selfApprovalAction  SelfApprovalAction     @default(skip) @map("self_approval_action")
  selfApprovalRef     Int?                   @map("self_approval_ref")
  template            ApprovalTemplate       @relation(fields: [templateId], references: [id])
  approvers           ApprovalStepApprover[]

  @@index([templateId])
  @@map("tbl_approval_steps")
}

model ApprovalStepApprover {
  id           Int          @id @default(autoincrement())
  stepId       Int          @map("step_id")
  approverType ApproverType @map("approver_type")
  approverRef  Int?         @map("approver_ref")
  step         ApprovalStep @relation(fields: [stepId], references: [id])

  @@index([stepId])
  @@map("tbl_approval_step_approvers")
}

model ApprovalBranchGroup {
  id         Int              @id @default(autoincrement())
  templateId Int              @map("template_id")
  branches   ApprovalBranch[]

  @@map("tbl_approval_branch_groups")
}

model ApprovalBranch {
  id            Int                 @id @default(autoincrement())
  branchGroupId Int                 @map("branch_group_id")
  branchName    String?             @map("branch_name")
  priority      Int                 @default(0)
  conditionJson String?             @map("condition_json")
  isDefault     Boolean             @default(false) @map("is_default")
  group         ApprovalBranchGroup @relation(fields: [branchGroupId], references: [id])

  @@index([branchGroupId])
  @@map("tbl_approval_branches")
}

model ApprovalFormField {
  id             Int     @id @default(autoincrement())
  templateId     Int     @map("template_id")
  fieldKey       String  @map("field_key")
  label          String?
  fieldType      String  @map("field_type")
  optionsJson    String? @map("options_json")
  required       Boolean @default(false)
  sortOrder      Int     @default(0) @map("sort_order")
  visibilityJson String? @map("visibility_json")

  @@index([templateId])
  @@map("tbl_approval_form_fields")
}

model ApprovalRequest {
  id                  Int     @id @default(autoincrement())
  templateId          Int     @map("template_id")
  objectType          String  @map("object_type")
  objectId            Int     @map("object_id")
  objectCode          String? @map("object_code")
  currentStepOrder    Int     @map("current_step_order")
  status              Int     @default(1)
  submittedBy         String  @map("submitted_by")
  submittedAt         Int     @map("submitted_at")
  pendingSince        Int?    @map("pending_since")
  finishedAt          Int?    @map("finished_at")
  formData            String? @map("form_data")
  resolvedBranchId    Int?    @map("resolved_branch_id")
  submittedOnBehalfBy String? @map("submitted_on_behalf_by")
  noAutoDedup         Boolean @default(false) @map("no_auto_dedup")
  modifiedOnce        Boolean @default(false) @map("modified_once")
  isDeleted           Boolean @default(false) @map("is_deleted")
  synced              Boolean @default(false) // business-sync idempotency flag

  @@index([objectType])
  @@index([status])
  @@map("tbl_approval_requests")
}

model ApprovalAction {
  id            Int        @id @default(autoincrement())
  requestId     Int        @map("request_id")
  stepOrder     Int        @map("step_order")
  stepName      String?    @map("step_name")
  action        ActionType
  actedBy       String     @map("acted_by")
  actedByUid    Int?       @map("acted_by_uid")
  actedAt       Int        @map("acted_at")
  note          String?
  voided        Boolean    @default(false)
  adminOverride Boolean    @default(false) @map("admin_override")

  @@index([requestId])
  @@map("tbl_approval_actions")
}

// Nhận xét trên phiếu — chép cột-đối-cột prod `tbl_approval_comments` (SHOW CREATE TABLE 24/09/2026).
// Máy ghi vết (`is_system = true`, `commented_by = 'system'`) dùng bảng này để để lại dấu THẤY ĐƯỢC
// trên phiếu, vd "[VI] TRU VI THAT BAI: …" khi bước trừ ví lúc duyệt xong không thành.
enum ApprovalCommentType {
  comment
  urge
}

model ApprovalComment {
  id          Int                 @id @default(autoincrement())
  requestId   Int                 @map("request_id")
  commentedBy String              @map("commented_by") @db.VarChar(50)
  commentType ApprovalCommentType @default(comment) @map("comment_type")
  comment     String?
  attachments String?
  mentions    String?             @db.VarChar(255)
  isSystem    Boolean             @default(false) @map("is_system")
  cdate       Int

  @@index([requestId])
  @@map("tbl_approval_comments")
}

model ApprovalRequestApprover {
  id               Int                   @id @default(autoincrement())
  requestId        Int                   @map("request_id")
  stepOrder        Int                   @map("step_order")
  username         String
  changeType       RequestApproverChange @map("change_type")
  replacedUsername String?               @map("replaced_username")
  removed          Boolean               @default(false)

  @@index([requestId])
  @@map("tbl_approval_request_approvers")
}

// ===== Danh mục lõi (master data) =====

enum KhoLoai {
  VN
  TQ
}

model Customer {
  id            Int     @id @default(autoincrement())
  code          String  @unique @db.VarChar(50)
  name          String  @db.VarChar(255)
  companyNameVn String? @map("company_name_vn") @db.VarChar(255)
  taxCode       String? @map("tax_code") @db.VarChar(50)
  groupCode     String? @map("group_code") @db.VarChar(50)
  phone         String? @db.VarChar(50)
  email         String? @db.VarChar(150)
  address       String?
  bankName      String? @map("bank_name") @db.VarChar(150)
  bankAccount   String? @map("bank_account") @db.VarChar(80)
  // Đăng nhập cổng khách — TÁCH KHỎI tbl_user (#01)
  username      String? @unique @db.VarChar(50)
  password      String? @db.VarChar(255)
  // Sale sở hữu — ScopeService #01 lọc theo 2 cột này
  saler         String? @db.VarChar(50)
  salerOther    String? @map("saler_other")
  source        Int     @default(0)
  isNew         Int     @default(1) @map("is_new")
  // Tín dụng — VND BigInt; CHỈ đặt qua duyệt (#04)
  creditLimit   BigInt  @default(0) @map("credit_limit")
  creditDays    Int     @default(0) @map("credit_days")
  creditAt      Int?    @map("credit_at")
  creditBy      String? @map("credit_by") @db.VarChar(50)
  type          Int     @default(1)
  author        String? @db.VarChar(50)
  editBy        String? @map("edit_by") @db.VarChar(50)
  cdate         Int
  mdate         Int
  isactive      Int     @default(1)

  @@index([saler])
  @@map("tbl_customer")
}

model CustomerGroup {
