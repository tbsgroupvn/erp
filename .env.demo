# ============================================
# Demo Environment Configuration
# Usage: cp .env.demo .env && docker compose -f docker-compose.selfhost.yml -f docker-compose.demo.yml up -d
# ============================================

# --- Project ---
COMPOSE_PROJECT_NAME=erp-demo

# --- Company Branding ---
COMPANY_NAME=Demo ERP
COMPANY_FULL_NAME=Demo ERP Company
APP_TITLE=Demo ERP System
APP_DESCRIPTION=Try our ERP system — demo resets every 24 hours
CMS_TITLE=Demo CMS
CMS_DESCRIPTION=Content Management System Demo
CUSTOMER_CODE_PREFIX=DEMO-KH-
SUPPORT_EMAIL=demo@example.com
SUPPORT_PHONE=
COMPANY_ADDRESS=
AUTH_COOKIE=erp-auth
SEED_EMAIL_DOMAIN=demo.example.com

# --- Domains (change to your demo domain) ---
CMS_DOMAIN=demo.localhost
ERP_DOMAIN=erp.demo.localhost
API_DOMAIN=api.demo.localhost

# --- Database ---
POSTGRES_USER=demo_user
POSTGRES_PASSWORD=demo_password_change_me
POSTGRES_DB=erp_demo

# --- Redis ---
REDIS_PASSWORD=demo_redis_change_me

# --- JWT ---
JWT_SECRET=demo_jwt_secret_change_me_in_production_this_is_not_secure
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=demo_jwt_refresh_secret_change_me_in_production
JWT_REFRESH_EXPIRES_IN=7d

# --- Demo Mode ---
DEMO_MODE=true

# --- Misc ---
LOG_LEVEL=info
